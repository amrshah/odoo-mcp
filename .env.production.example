# ==============================================================================
# Production Environment Configuration for Hetzner CX43 VPS Deployment
# ==============================================================================

# Database Configuration
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace_with_secure_postgres_password_123

# Odoo Server Configuration
ODOO_DB=odoo_hospital
ODOO_USERNAME=admin
ODOO_PASSWORD=replace_with_secure_odoo_admin_password_123
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# MCP Server & Bridge Configuration
MCP_SERVER_PORT=8008
BRIDGE_API_KEY=replace_with_secure_bridge_gateway_key
BRIDGE_SIGNING_SECRET=replace_with_hmac_sha256_signing_secret
BRIDGE_EXECUTION_POLICY=read_only

# Zelix Copilot Backend Configuration
ZELIX_COPILOT_PORT=8010
ZELIX_ODOO_PILOT_MODE=dual

# Alamia AI Runtime Configuration (Hosted on same VPS / Network)
ALAMIA_AI_URL=https://ai.alamiaconnect.com
BITNET_API_KEY=your_bitnet_api_key_here
BITNET_DEFAULT_MODEL=/models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf

# Optional Local / Additional Model Endpoints (if Gemma / Ollama added later)
GEMMA_MODEL=
OLLAMA_HOST=
