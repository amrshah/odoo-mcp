<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rfp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.rfp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="International RFP" name="international_rfp_setting_container">
                    <setting string="RFP Reminders"
                             help="First reminder this many days before the questionnaire date and the last submission date. Further reminders on the due date and the day after.">
                        <div class="content-group">
                            <div class="mt8">
                                <field name="rfp_reminder_days" class="o_light_label" style="width: 4rem"/> day(s) before
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
