<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page hms_doc">
                        <style>
                            .hms_doc { font-family: Arial, sans-serif; font-size: 12px; color: #1a2238; }
                            .hms_doc_badge { display:inline-block; background:#0f9d7a; color:#fff; padding:4px 12px; border-radius:6px; font-weight:bold; }
                            .hms_doc_patient td { padding: 2px 8px 2px 0; }
                            .hms_doc_allergy { display:none; }
                            .hms_bill th { background:#f3f4fa; }
                            .hms_total td { font-weight:bold; }
                        </style>
                        <t t-set="company" t-value="doc.company_id"/>
                        <t t-set="doc_title" t-value="'BILL / INVOICE'"/>
                        <t t-set="doc_ref" t-value="doc.name"/>
                        <t t-call="stratos_hms.hms_doc_header"/>
                        <t t-set="patient" t-value="doc.hms_patient_id"/>
                        <t t-set="doc_date" t-value="doc.invoice_date and doc.invoice_date.strftime('%d %b %Y') or ''"/>
                        <t t-if="patient" t-call="stratos_hms.hms_patient_block"/>
                        <p t-if="doc.hms_visit_id"><b>Visit:</b> <span t-esc="doc.hms_visit_id.name"/> · <span t-esc="doc.hms_visit_id.department_id.name"/> · <span t-esc="doc.hms_visit_id.doctor_id.display_name or ''"/></p>
                        <table class="table table-sm hms_bill">
                            <thead><tr><th>Service</th><th class="text-end">Qty</th><th class="text-end">Rate</th><th class="text-end">Disc %</th><th class="text-end">Amount</th></tr></thead>
                            <tbody>
                                <tr t-foreach="doc.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="l">
                                    <td t-esc="l.name"/>
                                    <td class="text-end" t-esc="'%g' % l.quantity"/>
                                    <td class="text-end" t-esc="'{:,.0f}'.format(l.price_unit)"/>
                                    <td class="text-end" t-esc="'%g' % l.discount"/>
                                    <td class="text-end" t-esc="'{:,.0f}'.format(l.price_subtotal)"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="hms_total"><td colspan="4" class="text-end">Total charged</td><td class="text-end" t-esc="'{:,.0f}'.format(doc.amount_total)"/></tr>
                                <tr><td colspan="4" class="text-end">Paid</td><td class="text-end" t-esc="'{:,.0f}'.format(doc.amount_total - doc.amount_residual)"/></tr>
                                <tr class="hms_total"><td colspan="4" class="text-end">Outstanding</td><td class="text-end" t-esc="'{:,.0f}'.format(doc.amount_residual)"/></tr>
                            </tfoot>
                        </table>
                        <p t-if="doc.narration" class="small text-muted" t-out="doc.narration"/>
                        <p class="small text-muted">Amounts in <t t-esc="doc.currency_id.name"/>. Payment methods: cash, card, JazzCash, EasyPaisa. Generated by Stratos HMS.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
