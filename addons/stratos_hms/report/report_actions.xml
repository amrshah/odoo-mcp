<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">hms.consult</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stratos_hms.report_prescription</field>
        <field name="report_file">stratos_hms.report_prescription</field>
        <field name="print_report_name">'Prescription - %s' % object.patient_id.name</field>
        <field name="binding_model_id" ref="model_hms_consult"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_hms_a4"/>
    </record>
    <record id="action_report_bill" model="ir.actions.report">
        <field name="name">Hospital Bill</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stratos_hms.report_bill</field>
        <field name="report_file">stratos_hms.report_bill</field>
        <field name="print_report_name">'Bill - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_hms_a4"/>
    </record>
    <record id="action_report_lab" model="ir.actions.report">
        <field name="name">Lab / Imaging Report</field>
        <field name="model">hms.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stratos_hms.report_lab</field>
        <field name="report_file">stratos_hms.report_lab</field>
        <field name="print_report_name">'Report - %s - %s' % (object.patient_id.name, object.test_id.name)</field>
        <field name="binding_model_id" ref="model_hms_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_hms_a4"/>
    </record>
    <record id="action_report_discharge" model="ir.actions.report">
        <field name="name">Discharge Summary</field>
        <field name="model">hms.admission</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stratos_hms.report_discharge</field>
        <field name="report_file">stratos_hms.report_discharge</field>
        <field name="print_report_name">'Discharge - %s' % object.patient_id.name</field>
        <field name="binding_model_id" ref="model_hms_admission"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_hms_a4"/>
    </record>
</odoo>
