<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_discharge">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page hms_doc">
                        <style>
                            .hms_doc { font-family: Arial, sans-serif; font-size: 12px; color: #1a2238; }
                            .hms_doc_badge { display:inline-block; background:#4f46e5; color:#fff; padding:4px 12px; border-radius:6px; font-weight:bold; }
                            .hms_doc_patient td { padding: 2px 8px 2px 0; }
                            .hms_doc_allergy { background:#fee2e2; color:#991b1b; padding:6px 10px; border-radius:6px; font-weight:bold; margin:6px 0; }
                        </style>
                        <t t-set="company" t-value="doc.env.company"/>
                        <t t-set="doc_title" t-value="'DISCHARGE SUMMARY'"/>
                        <t t-set="doc_ref" t-value="doc.name"/>
                        <t t-call="stratos_hms.hms_doc_header"/>
                        <t t-set="patient" t-value="doc.patient_id"/>
                        <t t-set="doc_date" t-value="(doc.discharged_at or doc.admitted_at).strftime('%d %b %Y')"/>
                        <t t-call="stratos_hms.hms_patient_block"/>
                        <div t-out="doc.discharge_summary"/>
                        <div class="row mt-5"><div class="col-6"></div><div class="col-6 text-end"><div style="border-top:1px solid #1a2238; display:inline-block; padding-top:4px; min-width:200px;"><span t-esc="doc.doctor_id.display_name"/><br/><span class="small text-muted">Discharging doctor</span></div></div></div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
