<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_prescription">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page hms_doc">
                        <style>
                            .hms_doc { font-family: Arial, sans-serif; font-size: 12px; color: #1a2238; }
                            .hms_doc_badge { display:inline-block; background:#4f46e5; color:#fff; padding:4px 12px; border-radius:6px; font-weight:bold; }
                            .hms_doc_patient td { padding: 2px 8px 2px 0; }
                            .hms_doc_allergy { background:#fee2e2; color:#991b1b; padding:6px 10px; border-radius:6px; font-weight:bold; margin:6px 0; }
                            .hms_rx th { background:#f3f4fa; }
                            .hms_sign { margin-top:40px; }
                        </style>
                        <t t-set="company" t-value="doc.env.company"/>
                        <t t-set="doc_title" t-value="'PRESCRIPTION'"/>
                        <t t-set="doc_ref" t-value="doc.name"/>
                        <t t-call="stratos_hms.hms_doc_header"/>
                        <t t-set="patient" t-value="doc.patient_id"/>
                        <t t-set="doc_date" t-value="(doc.signed_at or doc.create_date).strftime('%d %b %Y')"/>
                        <t t-call="stratos_hms.hms_patient_block"/>
                        <p><b>Doctor:</b> <span t-esc="doc.doctor_id.display_name"/> <t t-if="doc.doctor_id.qualification">(<span t-esc="doc.doctor_id.qualification"/>)</t> · <span t-esc="doc.department_id.name"/> <t t-if="doc.doctor_id.pmdc_no">· PMDC <span t-esc="doc.doctor_id.pmdc_no"/></t></p>
                        <p><b>Diagnosis:</b> <span t-esc="doc.working_diagnosis or doc.complaint"/></p>
                        <t t-set="rx" t-value="doc.prescription_ids.filtered(lambda l: l.state == 'approved')"/>
                        <table class="table table-sm hms_rx" t-if="rx">
                            <thead><tr><th>#</th><th>Medicine</th><th>Dose</th><th>Route</th><th>Frequency</th><th>Days</th><th>Qty</th><th>Instructions</th></tr></thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <tr t-foreach="rx" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <td t-esc="i"/>
                                    <td><b t-esc="l.drug_id.name"/><t t-if="l.drug_id.brand"> <span class="text-muted">(<t t-esc="l.drug_id.brand"/>)</span></t></td>
                                    <td t-esc="l.dose"/>
                                    <td t-esc="l.route_label"/>
                                    <td t-esc="l.frequency_label"/>
                                    <td t-esc="l.duration_days"/>
                                    <td t-esc="l.quantity"/>
                                    <td t-esc="l.instructions or ''"/>
                                </tr>
                            </tbody>
                        </table>
                        <t t-set="orders" t-value="doc.order_ids.filtered(lambda o: o.state not in ('proposed', 'cancelled'))"/>
                        <div t-if="orders"><b>Investigations advised:</b>
                            <ul><li t-foreach="orders" t-as="o"><span t-esc="o.test_id.name"/> <span class="text-muted">[<t t-esc="o.urgency.upper()"/>]</span></li></ul>
                        </div>
                        <p t-if="doc.plan"><b>Advice:</b> <span t-esc="doc.plan"/></p>
                        <p t-if="doc.follow_up_days"><b>Follow-up:</b> in <span t-esc="doc.follow_up_days"/> days</p>
                        <p t-if="doc.refer_department_id"><b>Referred to:</b> <span t-esc="doc.refer_department_id.name"/> <t t-if="doc.refer_doctor_id">— <span t-esc="doc.refer_doctor_id.display_name"/></t></p>
                        <div class="hms_sign row">
                            <div class="col-6"></div>
                            <div class="col-6 text-end"><div style="border-top:1px solid #1a2238; display:inline-block; padding-top:4px; min-width:200px;"><span t-esc="doc.doctor_id.display_name"/><br/><span class="small text-muted">Signed electronically <t t-esc="doc.signed_at and doc.signed_at.strftime('%d %b %Y %H:%M') or ''"/></span></div></div>
                        </div>
                        <p class="small text-muted mt-3">Generated by Stratos HMS. Keep this prescription; bring it to your follow-up visit.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
