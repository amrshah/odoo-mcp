<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_lab">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page hms_doc">
                        <style>
                            .hms_doc { font-family: Arial, sans-serif; font-size: 12px; color: #1a2238; }
                            .hms_doc_badge { display:inline-block; background:#4f46e5; color:#fff; padding:4px 12px; border-radius:6px; font-weight:bold; }
                            .hms_doc_patient td { padding: 2px 8px 2px 0; }
                            .hms_doc_allergy { background:#fee2e2; color:#991b1b; padding:6px 10px; border-radius:6px; font-weight:bold; margin:6px 0; }
                            .hms_crit { color:#b91c1c; font-weight:bold; }
                        </style>
                        <t t-set="company" t-value="doc.env.company"/>
                        <t t-set="doc_title" t-value="'LAB REPORT' if doc.category == 'lab' else 'REPORT'"/>
                        <t t-set="doc_ref" t-value="doc.name"/>
                        <t t-call="stratos_hms.hms_doc_header"/>
                        <t t-set="patient" t-value="doc.patient_id"/>
                        <t t-set="doc_date" t-value="(doc.verified_at or doc.create_date).strftime('%d %b %Y %H:%M')"/>
                        <t t-call="stratos_hms.hms_patient_block"/>
                        <p><b>Ordered by:</b> <span t-esc="doc.ordered_by_id.display_name or ''"/> · <b>Urgency:</b> <span t-esc="doc.urgency.upper()"/> · <b>Specimen:</b> <span t-esc="doc.specimen_barcode"/> <t t-if="doc.collected_at">collected <span t-esc="doc.collected_at.strftime('%d %b %H:%M')"/></t></p>
                        <table class="table table-sm">
                            <thead><tr><th>Test</th><th>Result</th><th>Unit</th><th>Reference</th><th>Flag</th></tr></thead>
                            <tbody><tr>
                                <td t-esc="doc.test_id.name"/>
                                <td t-att-class="'hms_crit' if doc.flag == 'critical' else ''" t-esc="doc.result_value or 'see report below'"/>
                                <td t-esc="doc.test_id.unit or ''"/>
                                <td><t t-if="doc.test_id.numeric"><t t-esc="'%g' % doc.test_id.ref_low"/> – <t t-esc="'%g' % doc.test_id.ref_high"/></t><t t-else=""><t t-esc="doc.test_id.ref_text or ''"/></t></td>
                                <td t-att-class="'hms_crit' if doc.flag == 'critical' else ''" t-esc="(doc.flag or '').upper()"/>
                            </tr></tbody>
                        </table>
                        <div t-if="doc.result_text" style="white-space:pre-wrap" t-esc="doc.result_text"/>
                        <p class="mt-4 small text-muted">Resulted by <span t-esc="doc.resulted_by_id.display_name or ''"/> · Verified &amp; released by <span t-esc="doc.verified_by_id.display_name or ''"/> <t t-if="doc.verified_at">on <span t-esc="doc.verified_at.strftime('%d %b %Y %H:%M')"/></t>. <t t-if="doc.flag == 'critical'">Critical value phoned to <t t-esc="doc.doctor_id.display_name"/>.</t></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
