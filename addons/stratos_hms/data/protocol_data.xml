<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="protocol_diarrhoea_adult" model="hms.protocol"><field name="name">Acute watery diarrhoea (adult)</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_a09"/><field name="trigger_keywords">diarrhoea,diarrhea,loose motions,loose stools,dast,motions,watery stool</field><field name="age_group">adult</field><field name="reasoning">Acute watery diarrhoea is most often viral or self-limiting; management is rehydration and zinc, with antibiotics reserved for dysentery (blood/mucus), cholera-like purging, or the febrile toxic patient.</field><field name="red_flags">Blood in stool, high fever, severe dehydration (low BP, tachycardia, low urine), persistent vomiting, &gt; 7 days, elderly/diabetic — consider admission and stool culture.</field><field name="source">WHO / National Guidelines Pakistan</field><field name="investigation_ids" eval="[(6, 0, [ref('test_stool_re'), ref('test_elec')])]"/></record>
    <record id="protocol_diarrhoea_adult_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_diarrhoea_adult"/><field name="sequence">0</field><field name="drug_id" ref="drug_ors"/><field name="dose">200 ml after each loose stool</field><field name="route">po</field><field name="frequency">prn</field><field name="duration_days">3</field><field name="reason">Replaces fluid and electrolytes — the treatment that saves lives</field></record>
    <record id="protocol_diarrhoea_adult_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_diarrhoea_adult"/><field name="sequence">1</field><field name="drug_id" ref="drug_zinc_20"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">14</field><field name="reason">Shortens duration and reduces recurrence</field></record>
    <record id="protocol_diarrhoea_adult_l2" model="hms.protocol.line"><field name="protocol_id" ref="protocol_diarrhoea_adult"/><field name="sequence">2</field><field name="drug_id" ref="drug_ondansetron_8"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">bd</field><field name="duration_days">2</field><field name="reason">Only if vomiting prevents oral rehydration</field></record>
    <record id="protocol_diarrhoea_paed" model="hms.protocol"><field name="name">Acute diarrhoea (child)</field><field name="department_id" ref="dept_paeds"/><field name="icd10_id" ref="icd_a09"/><field name="trigger_keywords">diarrhoea,diarrhea,loose motions,loose stools,dast,motions,bachay</field><field name="age_group">paed</field><field name="reasoning">IMCI: assess dehydration (Plan A/B/C); ORS and zinc for every child; no antimotility drugs; antibiotics only for bloody diarrhoea or cholera.</field><field name="red_flags">Sunken eyes, unable to drink, lethargy, skin pinch &gt; 2 s, blood in stool, age &lt; 6 months with fever — admit for Plan C.</field><field name="source">WHO IMCI</field><field name="investigation_ids" eval="[(6, 0, [ref('test_stool_re')])]"/></record>
    <record id="protocol_diarrhoea_paed_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_diarrhoea_paed"/><field name="sequence">0</field><field name="drug_id" ref="drug_ors"/><field name="dose">per weight: 50-100 ml after each stool</field><field name="route">po</field><field name="frequency">prn</field><field name="duration_days">3</field><field name="reason">Plan A/B rehydration</field></record>
    <record id="protocol_diarrhoea_paed_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_diarrhoea_paed"/><field name="sequence">1</field><field name="drug_id" ref="drug_zinc_20"/><field name="dose">20 mg (10 mg if &lt; 6 months)</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">14</field><field name="reason">Reduces duration and severity</field></record>
    <record id="protocol_acs" model="hms.protocol"><field name="name">Acute coronary syndrome / suspected MI</field><field name="department_id" ref="dept_cardiology"/><field name="icd10_id" ref="icd_i21_0"/><field name="trigger_keywords">chest pain,central chest,left arm,jaw pain,sweating,heavy pressure,crushing,seenay mein dard,angina</field><field name="age_group">adult</field><field name="reasoning">Central chest pain radiating to arm/jaw with diaphoresis in a patient with risk factors (diabetes, smoking, family history) is ACS until proven otherwise: STAT ECG within 10 minutes and hs-troponin.</field><field name="red_flags">ST elevation → activate primary PCI / thrombolysis pathway within 90 minutes; hypotension, arrhythmia, pulmonary oedema.</field><field name="source">ESC 2023 / PSC</field><field name="refer_department_id" ref="dept_cardiology"/><field name="investigation_ids" eval="[(6, 0, [ref('test_ecg'), ref('test_trop'), ref('test_ckmb'), ref('test_cbc'), ref('test_creat'), ref('test_elec'), ref('test_cxr')])]"/></record>
    <record id="protocol_acs_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_acs"/><field name="sequence">0</field><field name="drug_id" ref="drug_aspirin_300"/><field name="dose">1 tab chewed</field><field name="route">po</field><field name="frequency">stat</field><field name="duration_days">1</field><field name="reason">Antiplatelet loading — reduces mortality in ACS</field></record>
    <record id="protocol_acs_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_acs"/><field name="sequence">1</field><field name="drug_id" ref="drug_clopidogrel_300"/><field name="dose">4 tab</field><field name="route">po</field><field name="frequency">stat</field><field name="duration_days">1</field><field name="reason">P2Y12 loading; ticagrelor if PCI planned and no contraindication</field></record>
    <record id="protocol_acs_l2" model="hms.protocol.line"><field name="protocol_id" ref="protocol_acs"/><field name="sequence">2</field><field name="drug_id" ref="drug_atorvastatin_40"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">hs</field><field name="duration_days">30</field><field name="reason">High-intensity statin from day 1</field></record>
    <record id="protocol_acs_l3" model="hms.protocol.line"><field name="protocol_id" ref="protocol_acs"/><field name="sequence">3</field><field name="drug_id" ref="drug_gtn_sl"/><field name="dose">1 tab</field><field name="route">sl</field><field name="frequency">prn</field><field name="duration_days">3</field><field name="reason">Symptom relief if SBP &gt; 90</field></record>
    <record id="protocol_acs_l4" model="hms.protocol.line"><field name="protocol_id" ref="protocol_acs"/><field name="sequence">4</field><field name="drug_id" ref="drug_enoxaparin_60"/><field name="dose">1 mg/kg</field><field name="route">sc</field><field name="frequency">bd</field><field name="duration_days">5</field><field name="reason">Anticoagulation pending revascularisation</field></record>
    <record id="protocol_dengue" model="hms.protocol"><field name="name">Dengue fever</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_a90"/><field name="trigger_keywords">dengue,fever,bukhar,body aches,retro-orbital,rash,platelets,bleeding gums</field><field name="age_group">any</field><field name="reasoning">Fever with myalgia, retro-orbital pain, rash or thrombocytopenia in dengue season: NS1 in first 5 days, then IgM. Supportive care; strictly NO NSAIDs/aspirin.</field><field name="red_flags">Warning signs: abdominal pain, persistent vomiting, mucosal bleeding, lethargy, platelets &lt; 50 or falling with rising haematocrit → admit.</field><field name="source">WHO 2009 / Punjab Dengue Guidelines</field><field name="investigation_ids" eval="[(6, 0, [ref('test_dengue'), ref('test_cbc'), ref('test_plt'), ref('test_lft')])]"/></record>
    <record id="protocol_dengue_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_dengue"/><field name="sequence">0</field><field name="drug_id" ref="drug_paracetamol_500"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">5</field><field name="reason">Antipyretic — the only safe analgesic in dengue</field></record>
    <record id="protocol_dengue_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_dengue"/><field name="sequence">1</field><field name="drug_id" ref="drug_ors"/><field name="dose">as tolerated</field><field name="route">po</field><field name="frequency">prn</field><field name="duration_days">5</field><field name="reason">Oral hydration</field></record>
    <record id="protocol_typhoid" model="hms.protocol"><field name="name">Enteric (typhoid) fever</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_a01_0"/><field name="trigger_keywords">typhoid,fever,bukhar,step ladder,abdominal pain,constipation,headache,prolonged fever</field><field name="age_group">any</field><field name="reasoning">Prolonged fever with abdominal symptoms and relative bradycardia; XDR typhoid is endemic in Sindh/Punjab, so azithromycin is first-line oral therapy and ceftriaxone if unwell.</field><field name="red_flags">Toxic appearance, GI bleed, perforation signs, unable to take orally → admit for IV ceftriaxone / meropenem.</field><field name="source">National XDR typhoid guidance</field><field name="investigation_ids" eval="[(6, 0, [ref('test_blood_cs'), ref('test_typhidot'), ref('test_cbc'), ref('test_lft')])]"/></record>
    <record id="protocol_typhoid_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_typhoid"/><field name="sequence">0</field><field name="drug_id" ref="drug_azithromycin_500"/><field name="dose">1 tab (20 mg/kg children)</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">7</field><field name="reason">First-line for XDR typhoid in Pakistan</field></record>
    <record id="protocol_typhoid_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_typhoid"/><field name="sequence">1</field><field name="drug_id" ref="drug_paracetamol_500"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">5</field><field name="reason">Antipyretic</field></record>
    <record id="protocol_urti" model="hms.protocol"><field name="name">Upper respiratory tract infection</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_j06_9"/><field name="trigger_keywords">cold,cough,sore throat,runny nose,khansi,zukam,gala,nasal congestion,sneezing</field><field name="age_group">any</field><field name="reasoning">Most URTIs are viral and self-limiting; antibiotics do not help and drive resistance. Symptomatic treatment only unless Centor criteria for streptococcal pharyngitis are met.</field><field name="red_flags">Stridor, drooling, unilateral tonsillar swelling, SpO2 &lt; 94, fever &gt; 5 days.</field><field name="source">NICE / CDC</field></record>
    <record id="protocol_urti_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_urti"/><field name="sequence">0</field><field name="drug_id" ref="drug_paracetamol_500"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">3</field><field name="reason">Fever and pain relief</field></record>
    <record id="protocol_urti_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_urti"/><field name="sequence">1</field><field name="drug_id" ref="drug_cetirizine_10"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">hs</field><field name="duration_days">5</field><field name="reason">Rhinorrhoea and sneezing</field></record>
    <record id="protocol_uti" model="hms.protocol"><field name="name">Urinary tract infection (uncomplicated)</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_n39_0"/><field name="trigger_keywords">burning urination,dysuria,frequency,urgency,peshab,jalan,lower abdominal pain,uti</field><field name="age_group">adult</field><field name="reasoning">Dysuria and frequency without flank pain or fever suggests cystitis; treat empirically and adjust to culture. Fluoroquinolone resistance is high locally — prefer nitrofurantoin.</field><field name="red_flags">Flank pain, rigors, fever &gt; 38.5, pregnancy, male patient, recurrent → culture and consider pyelonephritis.</field><field name="source">IDSA / local antibiogram</field><field name="investigation_ids" eval="[(6, 0, [ref('test_urine_re'), ref('test_urine_cs')])]"/></record>
    <record id="protocol_uti_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_uti"/><field name="sequence">0</field><field name="drug_id" ref="drug_nitrofurantoin_100"/><field name="dose">1 cap</field><field name="route">po</field><field name="frequency">bd</field><field name="duration_days">5</field><field name="reason">First-line for uncomplicated cystitis with low local resistance</field></record>
    <record id="protocol_uti_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_uti"/><field name="sequence">1</field><field name="drug_id" ref="drug_paracetamol_500"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">3</field><field name="reason">Symptom relief</field></record>
    <record id="protocol_gastritis" model="hms.protocol"><field name="name">Dyspepsia / gastritis</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_k29_7"/><field name="trigger_keywords">epigastric,burning,acidity,heartburn,bloating,indigestion,gas,tezabiyat,pait mein jalan</field><field name="age_group">adult</field><field name="reasoning">Epigastric burning related to meals without alarm features: PPI trial and lifestyle advice; test for H. pylori if persistent.</field><field name="red_flags">Weight loss, vomiting blood, black stools, dysphagia, age &gt; 55 with new symptoms → urgent endoscopy.</field><field name="source">Maastricht VI</field><field name="refer_department_id" ref="dept_gastro"/><field name="investigation_ids" eval="[(6, 0, [ref('test_hb')])]"/></record>
    <record id="protocol_gastritis_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_gastritis"/><field name="sequence">0</field><field name="drug_id" ref="drug_omeprazole_20"/><field name="dose">1 cap before breakfast</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">14</field><field name="reason">Acid suppression</field></record>
    <record id="protocol_gastritis_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_gastritis"/><field name="sequence">1</field><field name="drug_id" ref="drug_antacid"/><field name="dose">10 ml</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">5</field><field name="reason">Immediate symptom relief</field></record>
    <record id="protocol_hypertension" model="hms.protocol"><field name="name">Essential hypertension</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_i10"/><field name="trigger_keywords">high blood pressure,hypertension,bp high,headache,blood pressure</field><field name="age_group">adult</field><field name="reasoning">Persistent BP ≥ 140/90 confirmed on repeat; start a calcium channel blocker or ARB; check end-organ damage.</field><field name="red_flags">BP ≥ 180/120 with symptoms (chest pain, neuro deficit, breathlessness) = hypertensive emergency → ER.</field><field name="source">ISH 2020</field><field name="investigation_ids" eval="[(6, 0, [ref('test_creat'), ref('test_elec'), ref('test_lipid'), ref('test_bsf'), ref('test_ecg'), ref('test_urine_re')])]"/></record>
    <record id="protocol_hypertension_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_hypertension"/><field name="sequence">0</field><field name="drug_id" ref="drug_amlodipine_5"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">30</field><field name="reason">First-line CCB, well tolerated</field></record>
    <record id="protocol_hypertension_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_hypertension"/><field name="sequence">1</field><field name="drug_id" ref="drug_losartan_50"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">30</field><field name="reason">ARB — renal protection in diabetics; avoid in pregnancy</field></record>
    <record id="protocol_t2dm" model="hms.protocol"><field name="name">Type 2 diabetes mellitus</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_e11_9"/><field name="trigger_keywords">diabetes,sugar,high sugar,polyuria,thirst,weight loss,pyaas,peshab zyada</field><field name="age_group">adult</field><field name="reasoning">Random glucose ≥ 200 with symptoms or HbA1c ≥ 6.5%: metformin first-line with lifestyle advice; screen for complications.</field><field name="red_flags">Glucose &gt; 400, ketones, dehydration, altered consciousness → DKA/HHS pathway.</field><field name="source">ADA 2024 / PES</field><field name="refer_department_id" ref="dept_endo"/><field name="investigation_ids" eval="[(6, 0, [ref('test_bsf'), ref('test_hba1c'), ref('test_creat'), ref('test_lipid'), ref('test_urine_re')])]"/></record>
    <record id="protocol_t2dm_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_t2dm"/><field name="sequence">0</field><field name="drug_id" ref="drug_metformin_500"/><field name="dose">1 tab with meals</field><field name="route">po</field><field name="frequency">bd</field><field name="duration_days">30</field><field name="reason">First-line; weight-neutral; check creatinine</field></record>
    <record id="protocol_asthma_ex" model="hms.protocol"><field name="name">Asthma / COPD exacerbation</field><field name="department_id" ref="dept_pulmo"/><field name="icd10_id" ref="icd_j45_9"/><field name="trigger_keywords">wheeze,shortness of breath,breathless,saans,asthma,copd,tight chest</field><field name="age_group">any</field><field name="reasoning">Wheeze with increased work of breathing: bronchodilator nebulisation, oral steroid burst, oxygen to SpO2 94-98%.</field><field name="red_flags">SpO2 &lt; 92 despite oxygen, silent chest, exhaustion, PEFR &lt; 33% → ICU review.</field><field name="source">GINA 2024</field><field name="investigation_ids" eval="[(6, 0, [ref('test_cxr'), ref('test_cbc')])]"/></record>
    <record id="protocol_asthma_ex_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_asthma_ex"/><field name="sequence">0</field><field name="drug_id" ref="drug_salbutamol_neb"/><field name="dose">1 nebule</field><field name="route">neb</field><field name="frequency">q4h</field><field name="duration_days">2</field><field name="reason">Bronchodilation</field></record>
    <record id="protocol_asthma_ex_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_asthma_ex"/><field name="sequence">1</field><field name="drug_id" ref="drug_ipratropium_neb"/><field name="dose">1 nebule</field><field name="route">neb</field><field name="frequency">q6h</field><field name="duration_days">2</field><field name="reason">Added bronchodilation in moderate-severe attack</field></record>
    <record id="protocol_asthma_ex_l2" model="hms.protocol.line"><field name="protocol_id" ref="protocol_asthma_ex"/><field name="sequence">2</field><field name="drug_id" ref="drug_prednisolone_5"/><field name="dose">40 mg</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">5</field><field name="reason">Reduces relapse</field></record>
    <record id="protocol_malaria" model="hms.protocol"><field name="name">Malaria</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_b54"/><field name="trigger_keywords">malaria,fever with chills,rigors,bukhar,sweating,periodic fever,kapkapi</field><field name="age_group">any</field><field name="reasoning">Fever with rigors in an endemic area: test (ICT + smear) before treating; P. vivax predominates but falciparum is common in Sindh/Balochistan.</field><field name="red_flags">Impaired consciousness, jaundice, respiratory distress, parasitaemia &gt; 2%, unable to take orally → severe malaria, IV artesunate.</field><field name="source">WHO / Malaria Control Program Pakistan</field><field name="investigation_ids" eval="[(6, 0, [ref('test_mp'), ref('test_cbc'), ref('test_bsr')])]"/></record>
    <record id="protocol_malaria_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_malaria"/><field name="sequence">0</field><field name="drug_id" ref="drug_artemether_lum"/><field name="dose">4 tab (weight-banded)</field><field name="route">po</field><field name="frequency">bd</field><field name="duration_days">3</field><field name="reason">ACT first-line for falciparum</field></record>
    <record id="protocol_malaria_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_malaria"/><field name="sequence">1</field><field name="drug_id" ref="drug_paracetamol_500"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">3</field><field name="reason">Antipyretic</field></record>
    <record id="protocol_anaemia" model="hms.protocol"><field name="name">Iron deficiency anaemia</field><field name="department_id" ref="dept_medicine"/><field name="icd10_id" ref="icd_d50_9"/><field name="trigger_keywords">weakness,fatigue,pallor,kamzori,tiredness,anaemia,anemia,breathless on exertion</field><field name="age_group">any</field><field name="reasoning">Microcytic anaemia in a menstruating woman or with poor diet is usually iron deficiency; treat and look for a cause in men and post-menopausal women.</field><field name="red_flags">Hb &lt; 7, chest pain, heart failure, GI bleeding history → transfuse/investigate.</field><field name="source">BSH</field><field name="investigation_ids" eval="[(6, 0, [ref('test_cbc'), ref('test_hb'), ref('test_stool_re')])]"/></record>
    <record id="protocol_anaemia_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_anaemia"/><field name="sequence">0</field><field name="drug_id" ref="drug_ferrous_sulphate"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">90</field><field name="reason">Oral iron replacement; 3 months after Hb normalises</field></record>
    <record id="protocol_anaemia_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_anaemia"/><field name="sequence">1</field><field name="drug_id" ref="drug_folic_acid_5"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">od</field><field name="duration_days">30</field><field name="reason">Folate co-supplementation</field></record>
    <record id="protocol_lbp" model="hms.protocol"><field name="name">Mechanical low back pain</field><field name="department_id" ref="dept_ortho"/><field name="icd10_id" ref="icd_m54_5"/><field name="trigger_keywords">back pain,kamar dard,lower back,lifting,sciatica</field><field name="age_group">adult</field><field name="reasoning">Mechanical back pain without red flags: analgesia, stay active, physiotherapy; imaging not needed early.</field><field name="red_flags">Bladder/bowel dysfunction, saddle anaesthesia, progressive weakness, fever, weight loss, trauma, age &gt; 50 with new pain → image urgently.</field><field name="source">NICE NG59</field><field name="refer_department_id" ref="dept_physio"/><field name="investigation_ids" eval="[(6, 0, [ref('test_physio')])]"/></record>
    <record id="protocol_lbp_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_lbp"/><field name="sequence">0</field><field name="drug_id" ref="drug_paracetamol_500"/><field name="dose">2 tab</field><field name="route">po</field><field name="frequency">tds</field><field name="duration_days">5</field><field name="reason">First-line analgesia</field></record>
    <record id="protocol_lbp_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_lbp"/><field name="sequence">1</field><field name="drug_id" ref="drug_diclofenac_50"/><field name="dose">1 tab after food</field><field name="route">po</field><field name="frequency">bd</field><field name="duration_days">5</field><field name="reason">Short NSAID course if no renal/GI contraindication</field></record>
    <record id="protocol_tinea" model="hms.protocol"><field name="name">Fungal skin infection (tinea)</field><field name="department_id" ref="dept_derma"/><field name="icd10_id" ref="icd_b35_4"/><field name="trigger_keywords">itchy rash,ring,fungal,khujli,ringworm,scaly patch,groin rash</field><field name="age_group">any</field><field name="reasoning">Annular scaly itchy plaque with active border: topical azole for 2-4 weeks; keep dry.</field><field name="red_flags">Extensive, scalp involvement, immunocompromised → oral antifungal.</field><field name="source">BAD</field></record>
    <record id="protocol_tinea_l0" model="hms.protocol.line"><field name="protocol_id" ref="protocol_tinea"/><field name="sequence">0</field><field name="drug_id" ref="drug_clotrimazole_cream"/><field name="dose">thin layer beyond the edge</field><field name="route">top</field><field name="frequency">bd</field><field name="duration_days">21</field><field name="reason">Topical azole antifungal</field></record>
    <record id="protocol_tinea_l1" model="hms.protocol.line"><field name="protocol_id" ref="protocol_tinea"/><field name="sequence">1</field><field name="drug_id" ref="drug_cetirizine_10"/><field name="dose">1 tab</field><field name="route">po</field><field name="frequency">hs</field><field name="duration_days">7</field><field name="reason">Itch relief</field></record>
  </data>
</odoo>
