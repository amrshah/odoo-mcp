<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company isolation on the main clinical documents -->
        <record id="rule_hms_visit_company" model="ir.rule">
            <field name="name">Visit: company</field>
            <field name="model_id" ref="model_hms_visit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_hms_charge_company" model="ir.rule">
            <field name="name">Charge: company</field>
            <field name="model_id" ref="model_hms_charge"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Learned rules: a doctor edits only his own; HOD/manager see all -->
        <record id="rule_hms_ai_rule_own" model="ir.rule">
            <field name="name">Learned rules: own or shared</field>
            <field name="model_id" ref="model_hms_ai_rule"/>
            <field name="groups" eval="[(4, ref('group_hms_doctor'))]"/>
            <field name="domain_force">['|', '|', ('doctor_id.user_id', '=', user.id), ('scope', '!=', 'doctor'), ('create_uid', '=', user.id)]</field>
        </record>
        <record id="rule_hms_ai_rule_all" model="ir.rule">
            <field name="name">Learned rules: HOD sees all</field>
            <field name="model_id" ref="model_hms_ai_rule"/>
            <field name="groups" eval="[(4, ref('group_hms_hod'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
