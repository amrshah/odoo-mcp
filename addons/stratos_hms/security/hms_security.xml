<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_hms" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="sequence">5</field>
        </record>

        <record id="privilege_hms" model="res.groups.privilege">
            <field name="name">Hospital Management</field>
            <field name="sequence">5</field>
            <field name="category_id" ref="module_category_hms"/>
        </record>

        <!-- Every role: one login, one workspace -->
        <record id="group_hms_user" model="res.groups">
            <field name="name">Hospital Staff (read chart)</field>
            <field name="sequence">1</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can see patients, visits and the journey bar. Base for every hospital role.</field>
        </record>
        <record id="group_hms_receptionist" model="res.groups">
            <field name="name">Front Desk</field>
            <field name="sequence">2</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Register, queue, appointments, consents, collections, discount requests.</field>
        </record>
        <record id="group_hms_nurse" model="res.groups">
            <field name="name">Nurse</field>
            <field name="sequence">3</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
            <field name="comment">Vitals &amp; triage, treatment board, MAR (scan to give), handoffs.</field>
        </record>
        <record id="group_hms_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="sequence">4</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
            <field name="comment">Consults, AI assist, prescriptions, orders, referrals, rounds, teaching rules.</field>
        </record>
        <record id="group_hms_pharmacist" model="res.groups">
            <field name="name">Pharmacist</field>
            <field name="sequence">5</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
        </record>
        <record id="group_hms_lab" model="res.groups">
            <field name="name">Laboratory &amp; Imaging</field>
            <field name="sequence">6</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
        </record>
        <record id="group_hms_blood_bank" model="res.groups">
            <field name="name">Blood Bank</field>
            <field name="sequence">7</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
        </record>
        <record id="group_hms_ot" model="res.groups">
            <field name="name">Operation Theatre</field>
            <field name="sequence">8</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
        </record>
        <record id="group_hms_hod" model="res.groups">
            <field name="name">Head of Department (approvals)</field>
            <field name="sequence">9</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_doctor'))]"/>
            <field name="comment">Approves discounts by name; sees department dashboards.</field>
        </record>
        <record id="group_hms_manager" model="res.groups">
            <field name="name">Director / Administrator</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('group_hms_receptionist')), (4, ref('group_hms_nurse')), (4, ref('group_hms_hod')),
                                             (4, ref('group_hms_pharmacist')), (4, ref('group_hms_lab')), (4, ref('group_hms_blood_bank')), (4, ref('group_hms_ot')),
                                             (4, ref('account.group_account_invoice'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Command centre, configuration, formulary, protocols, every workspace.</field>
        </record>
    </data>
</odoo>
