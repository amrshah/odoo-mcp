<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vet_exam" model="ir.actions.report">
        <field name="name">Exam Findings</field>
        <field name="model">vet.exam</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stratos_vet_exam.report_vet_exam</field>
        <field name="report_file">stratos_vet_exam.report_vet_exam</field>
        <field name="print_report_name">'Exam - %s - %s' % (object.patient_name, object.name)</field>
        <field name="binding_model_id" ref="model_vet_exam"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vet_exam_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="mb-0" t-out="o.patient_name"/>
                <div class="text-muted small pb-2 mb-3" style="border-bottom:2px solid #0f766e">
                    <strong t-out="o.template_id.name"/>
                    · <span t-field="o.species"/>
                    · <span t-field="o.date"/>
                    · Ref <span t-out="o.name"/>
                    <t t-if="o.owner_id"> · Owner <span t-out="o.owner_id.name"/></t>
                    <t t-if="o.vet_id"> · Vet <span t-out="o.vet_id.name"/></t>
                </div>
                <t t-set="sections" t-value="o._get_report_sections()"/>
                <p t-if="not sections" class="text-muted">No findings were entered.</p>
                <t t-foreach="sections" t-as="sec">
                    <h5 class="mt-3 mb-1 pb-1 text-uppercase" style="color:#0b5850;border-bottom:1px solid #dbe3e8"
                        t-out="sec['name']"/>
                    <t t-foreach="sec['groups']" t-as="grp">
                        <div t-if="grp['name']" class="fw-bold mt-2" style="color:#b45309;font-size:12px"
                             t-out="grp['name']"/>
                        <table class="table table-sm table-borderless mb-1">
                            <tbody>
                                <tr t-foreach="grp['lines']" t-as="line">
                                    <td style="width:35%"><em t-out="line.name"/></td>
                                    <td t-out="line._get_result_html()"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="report_vet_exam">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="stratos_vet_exam.report_vet_exam_document"/>
            </t>
        </t>
    </template>
</odoo>
