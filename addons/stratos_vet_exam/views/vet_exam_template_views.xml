<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_exam_template_view_list" model="ir.ui.view">
        <field name="name">vet.exam.template.list</field>
        <field name="model">vet.exam.template</field>
        <field name="arch" type="xml">
            <list string="Exam Templates">
                <field name="name"/>
                <field name="species"/>
                <field name="section_count"/>
                <field name="field_count"/>
                <field name="default_note_count"/>
            </list>
        </field>
    </record>

    <record id="vet_exam_template_view_kanban" model="ir.ui.view">
        <field name="name">vet.exam.template.kanban</field>
        <field name="model">vet.exam.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div><span class="badge text-bg-info"><field name="species"/></span></div>
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted small">
                            <field name="field_count"/> fields ·
                            <field name="section_count"/> sections ·
                            <field name="default_note_count"/> default notes
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vet_exam_template_view_form" model="ir.ui.view">
        <field name="name">vet.exam.template.form</field>
        <field name="model">vet.exam.template</field>
        <field name="arch" type="xml">
            <form string="Exam Template">
                <header>
                    <button name="%(stratos_vet_exam.action_vet_exam_template_add_fields)d" type="action"
                            string="Add from Structure" class="btn-primary"
                            context="{'default_template_id': id}" invisible="not id"/>
                    <button name="action_resequence" type="object" string="Re-order as Structure"
                            invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exams" type="object" class="oe_stat_button" icon="fa-stethoscope">
                            <field name="exam_count" widget="statinfo" string="Exams"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1><field name="name" placeholder="e.g. Equine Wellness"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="species"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="section_count"/>
                            <field name="field_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="id">
                        Save the template, then click <b>Add from Structure</b> to pick headings and fields.
                    </div>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section_id" readonly="1"/>
                                    <field name="group_path" readonly="1"/>
                                    <field name="node_id" options="{'no_create': True}"/>
                                    <field name="type_label" readonly="1" optional="show"/>
                                    <field name="default_note" placeholder="Default note (optional)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="When to use this template…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vet_exam_template_view_search" model="ir.ui.view">
        <field name="name">vet.exam.template.search</field>
        <field name="model">vet.exam.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_species" string="Species" context="{'group_by': 'species'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vet_exam_template" model="ir.actions.act_window">
        <field name="name">Exam Templates</field>
        <field name="res_model">vet.exam.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build your first exam template</p>
            <p>Name it, then add headings or single fields from the master structure.</p>
        </field>
    </record>
</odoo>
