<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_cm_pattern_list" model="ir.ui.view">
        <field name="name">vet.cm.pattern.list</field>
        <field name="model">vet.cm.pattern</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="suppressed" decoration-bf="case_count &gt;= 5">
                <field name="species_id"/>
                <field name="item_type" widget="badge"/>
                <field name="item_name"/>
                <field name="case_count"/>
                <field name="success_rate" widget="progressbar"/>
                <field name="approved_count" optional="show"/>
                <field name="modified_count" optional="hide"/>
                <field name="rejected_count" optional="show"/>
                <field name="excluded_count" optional="show"/>
                <field name="acceptance_rate" optional="show"/>
                <field name="factor" optional="show"/>
                <field name="suppressed" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_vet_cm_pattern_form" model="ir.ui.view">
        <field name="name">vet.cm.pattern.form</field>
        <field name="model">vet.cm.pattern</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_reinstate" type="object" string="Reinstate" class="btn-primary"
                            invisible="not suppressed" groups="stratos_vet_case_memory.group_vet_cm_manager"/>
                    <button name="action_suppress" type="object" string="Suppress"
                            invisible="suppressed" groups="stratos_vet_case_memory.group_vet_cm_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <div class="o_stat_info">
                                <field name="case_count" class="o_stat_value"/>
                                <span class="o_stat_text">Cases</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Suppressed" bg_color="text-bg-danger" invisible="not suppressed"/>
                    <div class="oe_title"><h1><field name="item_name" readonly="1"/></h1></div>
                    <group>
                        <group string="Evidence">
                            <field name="species_id" readonly="1"/>
                            <field name="item_type" readonly="1"/>
                            <field name="known_count"/>
                            <field name="success_count"/>
                            <field name="success_rate"/>
                        </group>
                        <group string="Vet feedback">
                            <field name="approved_count"/>
                            <field name="modified_count"/>
                            <field name="rejected_count"/>
                            <field name="excluded_count"/>
                            <field name="acceptance_rate"/>
                            <field name="factor"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vet_cm_pattern_search" model="ir.ui.view">
        <field name="name">vet.cm.pattern.search</field>
        <field name="model">vet.cm.pattern</field>
        <field name="arch" type="xml">
            <search>
                <field name="item_name"/>
                <field name="species_id"/>
                <filter name="with_cases" string="With cases" domain="[('case_count', '&gt;', 0)]"/>
                <filter name="suppressed" string="Suppressed" domain="[('suppressed', '=', True)]"/>
                <group>
                    <filter name="g_species" string="Species" context="{'group_by': 'species_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by': 'item_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_vet_cm_pattern_graph" model="ir.ui.view">
        <field name="name">vet.cm.pattern.graph</field>
        <field name="model">vet.cm.pattern</field>
        <field name="arch" type="xml">
            <graph string="Knowledge base" type="bar">
                <field name="item_name"/>
                <field name="case_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_vet_cm_pattern" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">vet.cm.pattern</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'search_default_with_cases': 1, 'search_default_g_species': 1, 'search_default_g_type': 1}</field>
    </record>
</odoo>
