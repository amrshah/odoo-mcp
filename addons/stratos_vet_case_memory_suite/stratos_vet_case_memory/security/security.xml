<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_vet_cm" model="res.groups.privilege">
        <field name="name">Vet Clinical Suggestions</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_vet_cm_nurse" model="res.groups">
        <field name="name">Nurse / Reception</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_vet_cm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Enters animals, symptoms, vitals and voice notes. Cannot approve suggestions.</field>
    </record>
    <record id="group_vet_cm_vet" model="res.groups">
        <field name="name">Veterinarian</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_vet_cm"/>
        <field name="implied_ids" eval="[(4, ref('group_vet_cm_nurse'))]"/>
        <field name="comment">Runs suggestions, approves / modifies / rejects, finalises cases.</field>
    </record>
    <record id="group_vet_cm_manager" model="res.groups">
        <field name="name">Senior Vet / Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_vet_cm"/>
        <field name="implied_ids" eval="[(4, ref('group_vet_cm_vet'))]"/>
        <field name="comment">Maintains protocols, drug rules and thresholds; reviews suppressed patterns.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
