<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_exam_view_form_case_memory" model="ir.ui.view">
        <field name="name">vet.exam.form.case.memory</field>
        <field name="model">vet.exam</field>
        <field name="inherit_id" ref="stratos_vet_exam.vet_exam_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_print']" position="before">
                <button name="action_cm_get_suggestions" type="object" string="Clinical Suggestions"
                        class="btn-primary" icon="fa-lightbulb-o" invisible="state != 'draft'"
                        groups="stratos_vet_case_memory.group_vet_cm_vet"/>
                <button name="action_cm_send_plan" type="object" string="Write Approved A &amp; P"
                        icon="fa-share" invisible="state != 'draft' or not cm_case_id"
                        groups="stratos_vet_case_memory.group_vet_cm_vet"/>
            </xpath>
            <xpath expr="//header/button[@name='action_print']" position="attributes">
                <attribute name="class">btn-secondary</attribute>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box_cm" invisible="not cm_case_id">
                    <button name="action_cm_open_case" type="object" class="oe_stat_button" icon="fa-stethoscope">
                        <div class="o_stat_info">
                            <span class="o_stat_value"><field name="cm_case_id" readonly="1" options="{'no_open': True}"/></span>
                            <span class="o_stat_text">Clinical case</span>
                        </div>
                    </button>
                </div>
                <field name="cm_case_state" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert" invisible="not cm_pending_count or state != 'draft'">
                    <i class="fa fa-hourglass-half" title="Pending"/> <field name="cm_pending_count" class="d-inline"/>
                    suggestion(s) waiting for the vet's decision.
                    <button name="action_cm_get_suggestions" type="object" string="Review" class="btn-link p-0 ms-2"/>
                </div>
                <div class="alert alert-info mb-2" role="alert" invisible="not cm_diagnosis_id">
                    <i class="fa fa-check-circle" title="Approved"/> Approved diagnosis: <field name="cm_diagnosis_id" class="d-inline fw-bold" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <div class="mb-3" invisible="state != 'draft'">
                    <widget name="vet_voice_recorder"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="vet_exam_view_list_case_memory" model="ir.ui.view">
        <field name="name">vet.exam.list.case.memory</field>
        <field name="model">vet.exam</field>
        <field name="inherit_id" ref="stratos_vet_exam.vet_exam_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="cm_case_id" optional="show"/>
                <field name="cm_diagnosis_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
