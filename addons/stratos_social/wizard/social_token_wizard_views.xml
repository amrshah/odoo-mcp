<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_token_wizard_form" model="ir.ui.view">
        <field name="name">stratos.social.token.wizard.form</field>
        <field name="model">stratos.social.token.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    <ol class="mb-0">
                        <li>Open <a href="https://developers.facebook.com/tools/explorer/" target="_blank">Meta Graph API Explorer</a> and pick your Meta app.</li>
                        <li>Add permissions: <code>pages_show_list, pages_manage_posts, pages_read_engagement, business_management, instagram_basic, instagram_content_publish</code>.</li>
                        <li>Click <b>Generate Access Token</b>, choose your Page(s), copy the token and paste it below.</li>
                    </ol>
                </div>
                <group>
                    <field name="user_token" password="True" placeholder="EAAG..."/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_connect" type="object" string="Connect Pages" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
