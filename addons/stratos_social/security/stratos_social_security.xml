<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_social_marketing">
        <field name="name">Social Marketing</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_social_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_social_marketing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can write, schedule and publish posts on connected accounts.</field>
    </record>

    <record id="group_social_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_social_marketing"/>
        <field name="implied_ids" eval="[(4, ref('group_social_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can also connect / disconnect accounts and change settings.</field>
    </record>

    <data noupdate="1">
        <record id="rule_social_account_company" model="ir.rule">
            <field name="name">Social account: multi-company</field>
            <field name="model_id" ref="model_stratos_social_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_social_post_company" model="ir.rule">
            <field name="name">Social post: multi-company</field>
            <field name="model_id" ref="model_stratos_social_post"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_social_live_post_company" model="ir.rule">
            <field name="name">Social post result: multi-company</field>
            <field name="model_id" ref="model_stratos_social_live_post"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
