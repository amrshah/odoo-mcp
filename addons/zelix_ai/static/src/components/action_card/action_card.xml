<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zelix_ai.ActionCard">
        <div class="o_zelix_action_card card my-2 shadow-sm border-2 border-primary">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
                <span class="badge bg-primary text-white text-uppercase fw-bold" t-esc="props.card.action_type || 'Action'"/>
                <span class="badge bg-secondary text-white fw-semibold" t-esc="props.card.target_model"/>
            </div>
            <div class="card-body p-3 bg-white">
                <h6 class="card-title mb-1 text-dark fw-bold fs-6" t-esc="props.card.title"/>
                <p class="card-text text-dark small mb-3" style="color: #334155 !important;" t-esc="props.card.description"/>

                <t t-if="props.card.status === 'executed'">
                    <div class="alert alert-success py-2 px-3 mb-0 small text-center fw-bold border-success">
                        <i class="fa fa-check-circle me-1"/> Executed &amp; Persisted into Odoo
                    </div>
                </t>
                <t t-elif="props.card.status === 'rejected'">
                    <div class="alert alert-secondary py-2 px-3 mb-0 small text-center fw-bold">
                        <i class="fa fa-times-circle me-1"/> Proposal Dismissed
                    </div>
                </t>
                <t t-else="">
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button class="btn btn-sm btn-outline-dark fw-semibold px-3" t-on-click="onReject">
                            <i class="fa fa-times me-1"/> Dismiss
                        </button>
                        <button class="btn btn-sm btn-success text-white fw-bold px-3 shadow-sm" t-on-click="onApprove">
                            <i class="fa fa-check me-1"/> Approve &amp; Save
                        </button>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
