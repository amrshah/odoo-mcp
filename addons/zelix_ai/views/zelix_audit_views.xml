<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_zelix_copilot_audit_tree" model="ir.ui.view">
        <field name="name">zelix.copilot.audit.list</field>
        <field name="model">zelix.copilot.audit</field>
        <field name="arch" type="xml">
            <list string="Zelix AI Audit Trails" create="false" edit="false" delete="false">
                <field name="create_date" string="Timestamp"/>
                <field name="request_id"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="patient_id"/>
                <field name="workflow_id"/>
                <field name="validation_status" widget="badge"
                       decoration-success="validation_status == 'passed'"
                       decoration-danger="validation_status == 'failed'"/>
                <field name="execution_status" widget="badge"
                       decoration-success="execution_status == 'approved'"
                       decoration-warning="execution_status == 'proposed'"
                       decoration-danger="execution_status == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_zelix_copilot_audit_form" model="ir.ui.view">
        <field name="name">zelix.copilot.audit.form</field>
        <field name="model">zelix.copilot.audit</field>
        <field name="arch" type="xml">
            <form string="Zelix AI Audit Trace" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Invocation Meta">
                            <field name="request_id"/>
                            <field name="create_date" string="Invoked At"/>
                            <field name="user_id"/>
                            <field name="role"/>
                            <field name="patient_id"/>
                        </group>
                        <group string="Execution &amp; Safety Status">
                            <field name="workflow_id"/>
                            <field name="model_used"/>
                            <field name="validation_status"/>
                            <field name="execution_status"/>
                            <field name="action_cards_count"/>
                            <field name="odoo_record_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="User Prompt" name="prompt">
                            <field name="prompt_text" nolabel="1"/>
                        </page>
                        <page string="AI Response / Generation" name="response">
                            <field name="response_text" nolabel="1"/>
                        </page>
                        <page string="Validation Errors" name="errors" invisible="not validation_errors">
                            <field name="validation_errors" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_zelix_copilot_audit" model="ir.actions.act_window">
        <field name="name">AI Copilot Audit Logs</field>
        <field name="res_model">zelix.copilot.audit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI Copilot audit traces recorded yet.
            </p>
        </field>
    </record>
</odoo>
