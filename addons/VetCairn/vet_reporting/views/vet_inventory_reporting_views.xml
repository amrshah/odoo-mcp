<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_inventory_report_pivot" model="ir.ui.view"><field name="name">stock.quant.vet.inventory.pivot</field><field name="model">stock.quant</field><field name="arch" type="xml"><pivot string="Veterinary Inventory Analysis" sample="1"><field name="product_id" type="row"/><field name="location_id" type="col"/><field name="quantity" type="measure"/><field name="reserved_quantity" type="measure"/></pivot></field></record>
<record id="view_vet_inventory_report_graph" model="ir.ui.view"><field name="name">stock.quant.vet.inventory.graph</field><field name="model">stock.quant</field><field name="arch" type="xml"><graph string="Veterinary Stock by Location" type="bar" sample="1"><field name="product_id"/><field name="quantity" type="measure"/></graph></field></record>
<record id="action_vet_report_inventory" model="ir.actions.act_window"><field name="name">Inventory Analysis</field><field name="res_model">stock.quant</field><field name="view_mode">pivot,graph,list</field><field name="domain">[('product_id.is_vet_item','=',True),('location_id.usage','=','internal')]</field><field name="search_view_id" eval="False"/><field name="context">{}</field></record></odoo>
