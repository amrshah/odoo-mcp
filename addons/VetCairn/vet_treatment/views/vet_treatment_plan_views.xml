<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_treatment_plan_list" model="ir.ui.view"><field name="name">vet.treatment.plan.list</field><field name="model">vet.treatment.plan</field><field name="arch" type="xml"><list decoration-danger="priority == 'critical' or overdue_count &gt; 0" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"><field name="priority" widget="badge"/><field name="admitted_at"/><field name="patient_id"/><field name="title"/><field name="care_setting" widget="badge"/><field name="room"/><field name="provider_id"/><field name="diagnosis_ids" widget="many2many_tags" optional="show"/><field name="activity_count"/><field name="overdue_count"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_treatment_plan_form" model="ir.ui.view"><field name="name">vet.treatment.plan.form</field><field name="model">vet.treatment.plan</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Plan" class="btn-primary" invisible="state != 'draft'"/><button name="action_complete" type="object" string="Complete &amp; Discharge" class="btn-primary" invisible="state != 'active'" groups="vet_base.group_vet_veterinarian"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','active')"/><field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/></header><sheet><widget name="web_ribbon" title="CRITICAL" bg_color="text-bg-danger" invisible="priority != 'critical'"/><div class="oe_title"><div class="d-flex gap-2"><field name="priority" widget="badge"/><h1><field name="patient_id" options="{'no_create':True}"/></h1></div><h2 class="text-muted"><field name="title"/></h2><div><field name="name" readonly="1"/></div></div><group><group string="Clinical Context"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id" readonly="1"/><field name="provider_id"/><field name="appointment_id"/><field name="encounter_id"/><field name="diagnosis_ids" widget="many2many_tags"/></group><group string="Admission"><field name="care_setting"/><field name="room" invisible="care_setting == 'outpatient'"/><field name="admitted_at"/><field name="expected_discharge_at"/><field name="discharged_at"/><field name="activity_count" readonly="1"/><field name="overdue_count" readonly="1"/></group></group><notebook><page string="Treatment Activities" name="activities"><field name="line_ids" context="{'default_plan_id':id}"><list editable="bottom" decoration-danger="is_overdue" decoration-success="state == 'completed'"><field name="sequence" widget="handle"/><field name="is_overdue" column_invisible="True"/><field name="due_datetime"/><field name="name"/><field name="category"/><field name="assigned_to_id"/><field name="instructions" optional="show"/><field name="state" widget="badge"/></list></field></page><page string="Goals"><field name="goals"/></page><page string="Clinical Summary"><field name="clinical_summary"/></page><page string="Discharge Instructions"><field name="discharge_instructions"/></page></notebook></sheet><chatter/></form></field></record>
<record id="view_vet_treatment_plan_search" model="ir.ui.view"><field name="name">vet.treatment.plan.search</field><field name="model">vet.treatment.plan</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="provider_id"/><field name="diagnosis_ids"/><filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="hospitalized" string="Hospitalized" domain="[('care_setting','=','inpatient'),('state','=','active')]"/><filter name="critical" string="Critical" domain="[('priority','=','critical')]"/><filter name="completed" string="Completed" domain="[('state','=','completed')]"/><separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_setting" string="Care Setting" context="{'group_by':'care_setting'}"/><filter name="group_provider" string="Provider" context="{'group_by':'provider_id'}"/></search></field></record>
<record id="action_vet_treatment_plan" model="ir.actions.act_window"><field name="name">Treatment Plans</field><field name="res_model">vet.treatment.plan</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_vet_treatment_plan_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first treatment plan</p><p>Coordinate outpatient care, hospitalization, treatments, monitoring, and discharge.</p></field></record>
</odoo>
