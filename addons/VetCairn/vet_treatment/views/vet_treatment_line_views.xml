<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_treatment_line_kanban" model="ir.ui.view"><field name="name">vet.treatment.line.kanban</field><field name="model">vet.treatment.line</field><field name="arch" type="xml"><kanban default_group_by="state" quick_create="false" class="o_kanban_mobile"><field name="state"/><field name="is_overdue"/><templates><t t-name="card"><div class="d-flex align-items-start"><field name="patient_id" class="fw-bold fs-5"/><span t-if="record.is_overdue.raw_value" class="badge text-bg-danger ms-auto">OVERDUE</span></div><div class="mt-2"><field name="name" class="fw-bold"/></div><div class="text-muted"><field name="instructions"/></div><footer class="mt-3"><span><i class="fa fa-clock-o me-1"/><field name="due_datetime"/></span><span class="ms-auto"><field name="assigned_to_id"/></span></footer></t></templates></kanban></field></record>
<record id="view_vet_treatment_line_list" model="ir.ui.view"><field name="name">vet.treatment.line.list</field><field name="model">vet.treatment.line</field><field name="arch" type="xml"><list decoration-danger="is_overdue" decoration-success="state == 'completed'" decoration-muted="state == 'skipped'"><field name="is_overdue" column_invisible="True"/><field name="due_datetime"/><field name="patient_id"/><field name="plan_id"/><field name="name"/><field name="category"/><field name="assigned_to_id"/><field name="completed_at" optional="show"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_treatment_line_form" model="ir.ui.view"><field name="name">vet.treatment.line.form</field><field name="model">vet.treatment.line</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'planned'"/><button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state not in ('planned','in_progress')"/><button name="action_skip" type="object" string="Skip" invisible="state not in ('planned','in_progress')"/><field name="state" widget="statusbar" statusbar_visible="planned,in_progress,completed"/></header><sheet><widget name="web_ribbon" title="OVERDUE" bg_color="text-bg-danger" invisible="not is_overdue"/><div class="oe_title"><h1><field name="name"/></h1><h2><field name="patient_id" readonly="1"/></h2></div><group><group><field name="plan_id"/><field name="category"/><field name="assigned_to_id"/><field name="due_datetime"/></group><group><field name="completed_at"/><field name="completed_by_id"/></group></group><field name="instructions"/><field name="result_notes"/><field name="skip_reason" invisible="state != 'skipped'"/></sheet></form></field></record>
<record id="view_vet_treatment_line_search" model="ir.ui.view"><field name="name">vet.treatment.line.search</field><field name="model">vet.treatment.line</field><field name="arch" type="xml"><search><field name="patient_id"/><field name="plan_id"/><field name="name"/><field name="assigned_to_id"/><filter name="open" string="Open" domain="[('state','in',('planned','in_progress'))]"/><filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/><filter name="mine" string="Assigned to Me" domain="[('assigned_to_id','=',uid)]"/><separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/><filter name="group_assignee" string="Assigned To" context="{'group_by':'assigned_to_id'}"/></search></field></record>
<record id="action_vet_treatment_board" model="ir.actions.act_window"><field name="name">Treatment Board</field><field name="res_model">vet.treatment.line</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_vet_treatment_line_search"/><field name="context">{'search_default_open':1}</field></record>
</odoo>
