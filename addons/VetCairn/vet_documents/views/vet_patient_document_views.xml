<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_patient_document_list" model="ir.ui.view"><field name="name">vet.patient.document.list</field><field name="model">vet.patient.document</field><field name="arch" type="xml"><list decoration-danger="is_expired or state == 'void'" decoration-success="state == 'signed'" decoration-warning="state == 'draft'"><field name="is_expired" column_invisible="True"/><field name="document_date"/><field name="name" optional="hide"/><field name="title"/><field name="patient_id"/><field name="client_id" optional="show"/><field name="document_type_id"/><field name="category" widget="badge"/><field name="filename" optional="show"/><field name="expiry_date"/><field name="signed_by_name" optional="show"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_patient_document_form" model="ir.ui.view"><field name="name">vet.patient.document.form</field><field name="model">vet.patient.document</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Mark Current" class="btn-primary" invisible="state != 'draft'"/><button name="action_sign" type="object" string="Mark Signed" class="btn-primary" invisible="state not in ('draft','current')"/><button name="action_mark_expired" type="object" string="Mark Expired" invisible="state not in ('current','signed')"/><button name="action_void" type="object" string="Void" invisible="state == 'void'" groups="vet_documents.group_vet_document_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,current,signed,expired"/></header><sheet><widget name="web_ribbon" title="EXPIRED" bg_color="text-bg-danger" invisible="not is_expired"/><div class="oe_title"><h1><field name="title" placeholder="Document title"/></h1><h2 class="text-muted"><field name="patient_id" options="{'no_create':True}"/></h2><div><field name="name" readonly="1"/></div></div><group><group string="Document"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id" readonly="1"/><field name="document_type_id" options="{'no_create':True}"/><field name="category" readonly="1"/><field name="document_date"/><field name="expiry_date"/></group><group string="Clinical Context"><field name="appointment_id"/><field name="encounter_id"/><field name="signed_by_name"/><field name="signed_at"/><field name="witnessed_by_id"/></group></group><group string="Secure File"><field name="file_data" filename="filename"/><field name="filename" invisible="1"/><field name="mime_type" invisible="1"/></group><notebook><page string="Description"><field name="description"/></page><page string="Void Details" invisible="state != 'void'"><field name="void_reason"/></page></notebook></sheet><chatter/></form></field></record>
<record id="view_vet_patient_document_search" model="ir.ui.view"><field name="name">vet.patient.document.search</field><field name="model">vet.patient.document</field><field name="arch" type="xml"><search><field name="title"/><field name="name"/><field name="patient_id"/><field name="client_id"/><field name="document_type_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="signed" string="Signed" domain="[('state','=','signed')]"/><filter name="expired" string="Expired" domain="[('is_expired','=',True)]"/><filter name="consents" string="Consent Forms" domain="[('category','=','consent')]"/><filter name="certificates" string="Certificates" domain="[('category','=','certificate')]"/><separator/><filter name="group_category" string="Category" context="{'group_by':'category'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
<record id="action_vet_patient_document" model="ir.actions.act_window"><field name="name">Patient Documents</field><field name="res_model">vet.patient.document</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_vet_patient_document_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Upload the first patient document</p><p>Securely store consents, certificates, clinical files, and diagnostic attachments.</p></field></record>
</odoo>
