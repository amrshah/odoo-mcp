<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_task_list" model="ir.ui.view"><field name="name">vet.task.list</field><field name="model">vet.task</field><field name="arch" type="xml"><list decoration-danger="is_overdue or priority == '3'" decoration-warning="state == 'blocked'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"><field name="is_overdue" column_invisible="True"/><field name="priority" widget="priority"/><field name="name" optional="hide"/><field name="title"/><field name="task_type_id"/><field name="patient_id" optional="show"/><field name="assigned_user_id" widget="many2one_avatar_user"/><field name="due_datetime"/><field name="checklist_label" optional="hide"/><field name="state" widget="badge"/><button name="action_start" type="object" icon="fa-play" title="Start" invisible="state not in ('open', 'blocked')"/><button name="action_done" type="object" icon="fa-check" title="Complete" invisible="state not in ('open', 'in_progress')"/></list></field></record>
    <record id="view_vet_task_kanban" model="ir.ui.view"><field name="name">vet.task.kanban</field><field name="model">vet.task</field><field name="arch" type="xml"><kanban default_group_by="state" class="o_kanban_small_column" sample="1"><field name="priority"/><field name="state"/><field name="is_overdue"/><field name="checklist_progress"/><field name="assigned_user_id"/><templates><t t-name="card"><div class="d-flex justify-content-between align-items-start mb-2"><field name="task_type_id" class="fw-semibold text-primary"/><field name="priority" widget="priority"/></div><div class="fs-5 fw-bold mb-1"><field name="title"/></div><div t-if="record.patient_id.raw_value" class="text-muted mb-2"><i class="fa fa-paw me-1" title="Patient"/><field name="patient_id"/></div><div class="d-flex justify-content-between align-items-center mt-3"><span t-att-class="record.is_overdue.raw_value ? 'text-danger fw-bold' : 'text-muted'"><i class="fa fa-clock-o me-1" title="Due"/><field name="due_datetime"/></span><field name="assigned_user_id" widget="many2one_avatar_user"/></div><div t-if="record.checklist_progress.raw_value" class="progress mt-2" style="height: 5px"><div class="progress-bar bg-success" t-attf-style="width: {{ record.checklist_progress.raw_value }}%"/></div></t></templates></kanban></field></record>
    <record id="view_vet_task_calendar" model="ir.ui.view"><field name="name">vet.task.calendar</field><field name="model">vet.task</field><field name="arch" type="xml"><calendar string="Task Deadlines" date_start="due_datetime" color="assigned_user_id" event_open_popup="true" mode="week"><field name="title"/><field name="patient_id"/><field name="task_type_id"/><field name="state" filters="1"/><field name="assigned_user_id" filters="1"/></calendar></field></record>
    <record id="view_vet_task_form" model="ir.ui.view"><field name="name">vet.task.form</field><field name="model">vet.task</field><field name="arch" type="xml"><form><header><button name="action_open" type="object" string="Open Task" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" type="object" string="Start Work" class="btn-primary" invisible="state not in ('open', 'blocked')"/><button name="action_done" type="object" string="Complete" class="btn-primary" invisible="state not in ('open', 'in_progress')"/><button name="action_block" type="object" string="Mark Blocked" invisible="state not in ('open', 'in_progress')"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/><button name="action_reset" type="object" string="Reopen" invisible="state not in ('done', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,open,in_progress,blocked,done"/></header><sheet><widget name="web_ribbon" title="OVERDUE" bg_color="text-bg-danger" invisible="not is_overdue"/><div class="oe_title"><div class="d-flex gap-2 align-items-center"><field name="priority" widget="priority"/><h1><field name="title" placeholder="What needs to be done?"/></h1></div><div class="text-muted"><field name="name" readonly="1"/></div></div><group><group string="Responsibility"><field name="assigned_user_id" widget="many2one_avatar_user"/><field name="task_type_id" options="{'no_create': True}"/><field name="due_datetime"/><field name="clinic_id"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Patient &amp; Visit Context"><field name="patient_id"/><field name="client_id" readonly="1"/><field name="appointment_id"/><field name="encounter_id"/></group></group><notebook><page string="Instructions"><field name="description" widget="html" placeholder="Add clear instructions, safety notes, or expected outcome..."/></page><page string="Checklist"><field name="checklist_line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="is_done" widget="boolean_toggle"/><field name="name"/><field name="is_required"/><field name="completed_by_id" readonly="1" optional="hide"/><field name="completed_at" readonly="1" optional="hide"/></list></field><div class="mt-2 text-muted"><field name="checklist_label" readonly="1" nolabel="1"/></div></page><page string="Blocker &amp; Outcome"><group><field name="blocking_reason" placeholder="Required before marking this task blocked..."/><field name="outcome" placeholder="Record the result or handover note..."/></group></page><page string="Audit"><group><field name="created_by_id"/><field name="started_at"/><field name="completed_at"/><field name="completed_by_id"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_vet_task_search" model="ir.ui.view"><field name="name">vet.task.search</field><field name="model">vet.task</field><field name="arch" type="xml"><search><field name="title"/><field name="name"/><field name="patient_id"/><field name="client_id"/><field name="assigned_user_id"/><field name="task_type_id"/><filter name="my_tasks" string="My Tasks" domain="[('assigned_user_id', '=', uid)]"/><filter name="open_tasks" string="Open" domain="[('state', 'in', ('open', 'in_progress', 'blocked'))]"/><filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/><filter name="blocked" string="Blocked" domain="[('state', '=', 'blocked')]"/><filter name="completed" string="Completed" domain="[('state', '=', 'done')]"/><separator/><filter name="group_assignee" string="Assigned To" context="{'group_by': 'assigned_user_id'}"/><filter name="group_type" string="Task Type" context="{'group_by': 'task_type_id'}"/><filter name="group_state" string="Status" context="{'group_by': 'state'}"/><filter name="group_due" string="Due Date" context="{'group_by': 'due_datetime:day'}"/></search></field></record>
    <record id="action_vet_task" model="ir.actions.act_window"><field name="name">All Tasks</field><field name="res_model">vet.task</field><field name="view_mode">kanban,list,calendar,form</field><field name="search_view_id" ref="view_vet_task_search"/><field name="context">{'search_default_open_tasks': 1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first clinic task</p><p>Coordinate clinical follow-up, client calls, inventory actions, and operational handovers.</p></field></record>
    <record id="action_vet_task_my_work" model="ir.actions.act_window"><field name="name">My Tasks</field><field name="res_model">vet.task</field><field name="view_mode">kanban,list,calendar,form</field><field name="search_view_id" ref="view_vet_task_search"/><field name="context">{'search_default_my_tasks': 1, 'search_default_open_tasks': 1}</field></record>
</odoo>
