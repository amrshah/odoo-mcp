<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_task_type_list" model="ir.ui.view"><field name="name">vet.task.type.list</field><field name="model">vet.task.type</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="clinical"/><field name="default_priority" widget="priority"/><field name="default_due_days"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field></record>
    <record id="view_vet_task_type_form" model="ir.ui.view"><field name="name">vet.task.type.form</field><field name="model">vet.task.type</field><field name="arch" type="xml"><form><sheet><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Clinical Follow-up"/></h1></div><group><group><field name="code"/><field name="clinical"/><field name="active" invisible="1"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="default_priority" widget="priority"/><field name="default_due_days"/></group></group><group string="Guidance"><field name="description" nolabel="1" placeholder="Explain when staff should use this task type..."/></group></sheet></form></field></record>
    <record id="action_vet_task_type" model="ir.actions.act_window"><field name="name">Task Types</field><field name="res_model">vet.task.type</field><field name="view_mode">list,form</field></record>
</odoo>
