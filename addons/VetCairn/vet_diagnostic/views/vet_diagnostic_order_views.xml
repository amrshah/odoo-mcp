<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_vet_diagnostic_order_list" model="ir.ui.view"><field name="name">vet.diagnostic.order.list</field><field name="model">vet.diagnostic.order</field><field name="arch" type="xml"><list decoration-danger="priority == 'stat' or abnormal" decoration-warning="priority == 'urgent'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"><field name="priority" widget="badge"/><field name="name" optional="hide"/><field name="ordered_at"/><field name="patient_id"/><field name="diagnostic_type_id"/><field name="category" widget="badge"/><field name="clinical_question"/><field name="requested_by_id"/><field name="specimen" optional="show"/><field name="external_reference" optional="hide"/><field name="abnormal" optional="show"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_vet_diagnostic_order_form" model="ir.ui.view"><field name="name">vet.diagnostic.order.form</field><field name="model">vet.diagnostic.order</field><field name="arch" type="xml"><form string="Diagnostic Order"><header><button name="action_order" type="object" string="Submit Order" class="btn-primary" invisible="state != 'draft'"/><button name="action_collect" type="object" string="Collect Specimen" class="btn-primary" invisible="state != 'ordered' or category != 'laboratory'"/><button name="action_start" type="object" string="Start Processing" class="btn-primary" invisible="state not in ('ordered', 'collected')"/><button name="action_complete" type="object" string="Complete Result" class="btn-primary" invisible="state not in ('ordered', 'collected', 'in_progress')" groups="vet_base.group_vet_technician"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'ordered', 'collected', 'in_progress')"/><button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'" groups="vet_base.group_vet_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,ordered,collected,in_progress,completed"/></header><sheet><widget name="web_ribbon" title="ABNORMAL" bg_color="text-bg-danger" invisible="not abnormal"/><div class="oe_title"><div class="d-flex gap-2 align-items-center"><field name="priority" widget="badge"/><h1 class="mb-0"><field name="patient_id" options="{'no_create': True}"/></h1></div><h2 class="text-muted"><field name="diagnostic_type_id" options="{'no_create': True}"/></h2><div class="text-muted"><field name="name" readonly="1"/></div></div><group><group string="Request"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id" readonly="1"/><field name="species_id" readonly="1"/><field name="encounter_id" options="{'no_create': True}"/><field name="requested_by_id"/><field name="ordered_at"/></group><group string="Specimen / External Lab"><field name="category" readonly="1"/><field name="specimen"/><field name="specimen_identifier"/><field name="collected_at"/><field name="collected_by_id"/><field name="external_reference"/></group></group><notebook><page string="Clinical Request" name="request"><field name="clinical_question" placeholder="Clinical question, signs, history, and requested investigation..."/></page><page string="Results" name="results"><group><field name="result_summary" placeholder="Concise result or interpretation"/><field name="abnormal"/><field name="resulted_at"/><field name="resulted_by_id"/></group><field name="result_details" placeholder="Detailed findings, measurements, interpretation and recommendations..."/><group><field name="result_file" filename="result_filename"/><field name="result_filename" invisible="1"/></group></page><page string="Cancellation" name="cancellation" invisible="state != 'cancelled'"><field name="cancellation_reason"/></page></notebook></sheet><chatter/></form></field></record>
 <record id="view_vet_diagnostic_order_search" model="ir.ui.view"><field name="name">vet.diagnostic.order.search</field><field name="model">vet.diagnostic.order</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="diagnostic_type_id"/><field name="requested_by_id"/><field name="external_reference"/><filter name="open" string="Open" domain="[('state', 'in', ('draft', 'ordered', 'collected', 'in_progress'))]"/><filter name="stat" string="STAT" domain="[('priority', '=', 'stat')]"/><filter name="abnormal" string="Abnormal" domain="[('abnormal', '=', True)]"/><filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/><separator/><filter name="group_category" string="Category" context="{'group_by': 'category'}"/><filter name="group_state" string="Status" context="{'group_by': 'state'}"/><filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/><filter name="group_provider" string="Requested By" context="{'group_by': 'requested_by_id'}"/></search></field></record>
 <record id="action_vet_diagnostic_order" model="ir.actions.act_window"><field name="name">Diagnostics</field><field name="res_model">vet.diagnostic.order</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_vet_diagnostic_order_search"/><field name="context">{'search_default_open': 1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first diagnostic request</p><p>Order laboratory or imaging work and track it through verified results.</p></field></record>
</odoo>
