<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_appointment_type_list" model="ir.ui.view">
        <field name="name">vet.appointment.type.list</field>
        <field name="model">vet.appointment.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="duration" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_vet_appointment_type_form" model="ir.ui.view">
        <field name="name">vet.appointment.type.form</field>
        <field name="model">vet.appointment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Internal description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vet_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">vet.appointment.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
