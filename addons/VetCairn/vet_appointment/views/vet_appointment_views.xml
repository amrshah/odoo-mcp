<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_appointment_calendar" model="ir.ui.view">
        <field name="name">vet.appointment.calendar</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start_datetime" date_stop="end_datetime" color="provider_id" mode="week" event_limit="8" quick_create="0">
                <field name="patient_id"/>
                <field name="client_id"/>
                <field name="provider_id" filters="1"/>
                <field name="clinic_id" filters="1"/>
                <field name="appointment_type_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="room"/>
                <field name="reason"/>
            </calendar>
        </field>
    </record>

    <record id="view_vet_appointment_list" model="ir.ui.view">
        <field name="name">vet.appointment.list</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'" decoration-warning="state in ('arrived', 'no_show')" decoration-info="state == 'in_progress'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name" optional="hide"/>
                <field name="start_datetime"/>
                <field name="end_datetime" optional="hide"/>
                <field name="patient_id"/>
                <field name="patient_species_id" optional="show"/>
                <field name="client_id"/>
                <field name="reason"/>
                <field name="appointment_type_id"/>
                <field name="provider_id"/>
                <field name="room" optional="show"/>
                <field name="clinic_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vet_appointment_kanban" model="ir.ui.view">
        <field name="name">vet.appointment.kanban</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false" default_group_by="state">
                <field name="state"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <field name="priority" widget="priority"/>
                            <field name="patient_id" class="fw-bold fs-5"/>
                            <field name="start_datetime" widget="remaining_days" class="ms-auto text-nowrap"/>
                        </div>
                        <div class="text-muted mb-2"><field name="reason"/></div>
                        <div class="d-flex flex-wrap gap-2 small">
                            <span><i class="fa fa-user-md me-1" title="Provider"/><field name="provider_id"/></span>
                            <span><i class="fa fa-stethoscope me-1" title="Type"/><field name="appointment_type_id"/></span>
                            <span t-if="record.room.raw_value"><i class="fa fa-map-marker me-1" title="Room"/><field name="room"/></span>
                        </div>
                        <footer class="mt-3">
                            <span><field name="start_datetime"/></span>
                            <field name="state" widget="label_selection" options="{'classes': {'scheduled': 'info', 'confirmed': 'primary', 'arrived': 'warning', 'in_progress': 'danger', 'completed': 'success', 'cancelled': 'default', 'no_show': 'warning'}}" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_vet_appointment_form" model="ir.ui.view">
        <field name="name">vet.appointment.form</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <form string="Veterinary Appointment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_arrive" type="object" string="Check In" class="btn-primary" invisible="state not in ('scheduled', 'confirmed')"/>
                    <button name="action_start" type="object" string="Start Visit" class="btn-primary" invisible="state != 'arrived'" groups="vet_base.group_vet_technician"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'in_progress'" groups="vet_base.group_vet_technician"/>
                    <button name="action_no_show" type="object" string="No Show" invisible="state not in ('scheduled', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('scheduled', 'confirmed', 'arrived', 'in_progress')"/>
                    <button name="action_reset_scheduled" type="object" string="Reset to Scheduled" invisible="state not in ('cancelled', 'no_show')" groups="vet_base.group_vet_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,confirmed,arrived,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_patient" type="object" class="oe_stat_button" icon="fa-paw">
                            <div class="o_stat_info"><span class="o_stat_text">Patient</span></div>
                        </button>
                        <button name="action_open_client" type="object" class="oe_stat_button" icon="fa-user" invisible="not client_id">
                            <div class="o_stat_info"><span class="o_stat_text">Client</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div class="d-flex align-items-center gap-2">
                            <field name="priority" widget="priority" class="me-1"/>
                            <h1 class="mb-0"><field name="patient_id" placeholder="Select patient" options="{'no_create': True}"/></h1>
                        </div>
                        <h2 class="text-muted"><field name="reason" placeholder="Reason for the visit"/></h2>
                        <div class="text-muted"><field name="name" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Patient &amp; Client">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="clinic_id" options="{'no_create': True}"/>
                            <field name="client_id" readonly="1"/>
                            <field name="client_phone" widget="phone" readonly="1" invisible="not client_phone"/>
                        </group>
                        <group string="Schedule">
                            <field name="appointment_type_id" options="{'no_create': True}"/>
                            <field name="provider_id" options="{'no_create': True}"/>
                            <field name="room" placeholder="Exam room or resource"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="booking_source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Patient Snapshot" name="patient_snapshot">
                            <group>
                                <group>
                                    <field name="patient_species_id" readonly="1"/>
                                    <field name="patient_breed_id" readonly="1"/>
                                    <field name="patient_sex" readonly="1"/>
                                </group>
                                <group>
                                    <field name="patient_age" readonly="1"/>
                                    <field name="patient_microchip" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Appointment notes..."/>
                        </page>
                        <page string="Status Details" name="status_details">
                            <group>
                                <field name="arrived_at"/>
                                <field name="started_at"/>
                                <field name="completed_at"/>
                                <field name="cancellation_reason" invisible="state != 'cancelled'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vet_appointment_search" model="ir.ui.view">
        <field name="name">vet.appointment.search</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="client_id"/>
                <field name="provider_id"/>
                <field name="clinic_id"/>
                <field name="appointment_type_id"/>
                <field name="priority"/>
                <field name="room"/>
                <filter name="today" string="Today" domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('start_datetime', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="upcoming" string="Upcoming" domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('state', 'in', ('scheduled', 'confirmed', 'arrived', 'in_progress'))]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                <filter name="group_clinic" string="Clinic" context="{'group_by': 'clinic_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_day" string="Day" context="{'group_by': 'start_datetime:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_vet_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">vet.appointment</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="search_view_id" ref="view_vet_appointment_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule the first veterinary appointment</p>
            <p>Book a patient with a provider, then track arrival and visit completion.</p>
        </field>
    </record>

    <record id="action_vet_appointment_today" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">vet.appointment</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="search_view_id" ref="view_vet_appointment_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
