<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_communication_list" model="ir.ui.view"><field name="name">vet.communication.list</field><field name="model">vet.communication</field><field name="arch" type="xml"><list decoration-danger="state == 'failed'" decoration-warning="state == 'planned'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"><field name="communication_datetime"/><field name="direction" widget="badge"/><field name="channel" widget="badge"/><field name="client_id"/><field name="patient_id" optional="show"/><field name="subject"/><field name="responsible_user_id" widget="many2one_avatar_user"/><field name="follow_up_required" optional="hide"/><field name="follow_up_datetime" optional="hide"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_communication_kanban" model="ir.ui.view"><field name="name">vet.communication.kanban</field><field name="model">vet.communication</field><field name="arch" type="xml"><kanban default_group_by="state" class="o_kanban_small_column"><field name="state"/><field name="channel"/><field name="direction"/><field name="responsible_user_id"/><templates><t t-name="card"><div class="d-flex justify-content-between mb-2"><field name="channel" widget="label_selection"/><field name="direction"/></div><div class="fw-bold fs-5"><field name="subject"/></div><div class="text-muted mt-1"><field name="client_id"/> <t t-if="record.patient_id.raw_value">· <field name="patient_id"/></t></div><div class="d-flex justify-content-between align-items-center mt-3"><field name="communication_datetime"/><field name="responsible_user_id" widget="many2one_avatar_user"/></div></t></templates></kanban></field></record>
<record id="view_vet_communication_form" model="ir.ui.view"><field name="name">vet.communication.form</field><field name="model">vet.communication</field><field name="arch" type="xml"><form><header><button name="action_plan" type="object" string="Plan" class="btn-primary" invisible="state != 'draft'"/><button name="action_complete" type="object" string="Complete / Record" class="btn-primary" invisible="state not in ('draft','planned','failed')"/><button name="action_fail" type="object" string="Mark Failed" invisible="state != 'planned'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,planned,completed"/></header><sheet><widget name="web_ribbon" title="FAILED" bg_color="text-bg-danger" invisible="state != 'failed'"/><div class="oe_title"><div class="d-flex gap-2"><h1><field name="subject" placeholder="Communication subject"/></h1></div><div class="text-muted"><field name="name" readonly="1"/></div></div><group><group string="Recipient &amp; Context"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id"/><field name="patient_id"/><field name="appointment_id"/><field name="encounter_id"/></group><group string="Communication"><field name="direction"/><field name="channel"/><field name="category"/><field name="template_id" options="{'no_create': True}"/><field name="communication_datetime"/><field name="responsible_user_id" widget="many2one_avatar_user"/></group></group><notebook><page string="Content"><field name="body" widget="html" placeholder="Record the communication content or outcome..."/></page><page string="Follow-up"><group><field name="follow_up_required"/><field name="follow_up_datetime" invisible="not follow_up_required" required="follow_up_required"/><field name="follow_up_user_id" invisible="not follow_up_required" required="follow_up_required"/><field name="follow_up_task_id" readonly="1"/></group></page><page string="Delivery &amp; Attachments"><group><group><field name="client_email" readonly="1"/><field name="client_phone" readonly="1"/><field name="external_reference"/><field name="failure_reason" invisible="state != 'failed'"/></group><group><field name="completed_at"/><field name="completed_by_id"/></group></group><field name="attachment_ids" widget="many2many_binary"/></page></notebook></sheet><chatter/></form></field></record>
<record id="view_vet_communication_search" model="ir.ui.view"><field name="name">vet.communication.search</field><field name="model">vet.communication</field><field name="arch" type="xml"><search><field name="name"/><field name="subject"/><field name="client_id"/><field name="patient_id"/><field name="responsible_user_id"/><filter name="queue" string="Queue" domain="[('state','in',('planned','failed'))]"/><filter name="inbound" string="Inbound" domain="[('direction','=','inbound')]"/><filter name="outbound" string="Outbound" domain="[('direction','=','outbound')]"/><filter name="follow_up" string="Follow-up Required" domain="[('follow_up_required','=',True)]"/><filter name="completed" string="Completed" domain="[('state','=','completed')]"/><separator/><filter name="group_channel" string="Channel" context="{'group_by':'channel'}"/><filter name="group_direction" string="Direction" context="{'group_by':'direction'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_client" string="Client" context="{'group_by':'client_id'}"/><filter name="group_date" string="Date" context="{'group_by':'communication_datetime:month'}"/></search></field></record>
<record id="action_vet_communication" model="ir.actions.act_window"><field name="name">Communication History</field><field name="res_model">vet.communication</field><field name="view_mode">list,kanban,form</field><field name="search_view_id" ref="view_vet_communication_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record the first client communication</p><p>Keep calls, emails, SMS, letters, and in-person conversations in one secure timeline.</p></field></record><record id="action_vet_communication_queue" model="ir.actions.act_window"><field name="name">Communication Queue</field><field name="res_model">vet.communication</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_vet_communication_search"/><field name="context">{'search_default_queue':1}</field></record>
</odoo>
