<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_purchase_order_form_vetcairn" model="ir.ui.view"><field name="name">purchase.order.form.vetcairn</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml">
<xpath expr="//header" position="inside"><button name="action_vet_request_review" type="object" string="Request Controlled Review" class="btn-primary" invisible="not is_vet_purchase or not vet_controlled_item or vet_review_state == 'approved' or state not in ('draft','sent')"/><button name="action_vet_approve" type="object" string="Approve Controlled Purchase" class="btn-primary" invisible="not is_vet_purchase or vet_review_state != 'pending' or state not in ('draft','sent')" groups="vet_procurement.group_vet_procurement_manager"/><button name="action_vet_reject" type="object" string="Reject" invisible="not is_vet_purchase or vet_review_state != 'pending'" groups="vet_procurement.group_vet_procurement_manager"/></xpath>
<xpath expr="//field[@name='partner_id']" position="before"><field name="is_vet_purchase" invisible="1"/><field name="vet_clinic_id" invisible="not is_vet_purchase" required="is_vet_purchase" options="{'no_create':True}"/></xpath>
<xpath expr="//notebook" position="inside"><page string="Veterinary Procurement" name="vetcairn_procurement" invisible="not is_vet_purchase"><group><group string="Review"><field name="vet_controlled_item"/><field name="vet_review_state" widget="badge"/><field name="vet_approved_by_id"/><field name="vet_approved_at"/><field name="vet_rejection_reason" invisible="vet_review_state != 'rejected'"/></group><group string="Operational Notes"><field name="vet_procurement_notes"/></group></group></page></xpath>
</field></record>
<record id="view_vet_purchase_order_list" model="ir.ui.view"><field name="name">purchase.order.veterinary.list</field><field name="model">purchase.order</field><field name="arch" type="xml"><list decoration-danger="vet_review_state == 'rejected'" decoration-warning="vet_review_state == 'pending'" decoration-success="state in ('purchase','done')"><field name="name"/><field name="date_order"/><field name="partner_id"/><field name="vet_clinic_id"/><field name="vet_controlled_item"/><field name="vet_review_state" widget="badge"/><field name="amount_total" widget="monetary"/><field name="currency_id" column_invisible="True"/><field name="receipt_status" widget="badge" optional="show"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_purchase_order_search" model="ir.ui.view"><field name="name">purchase.order.veterinary.search</field><field name="model">purchase.order</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="vet_clinic_id"/><filter name="pending_review" string="Pending Controlled Review" domain="[('vet_review_state','=','pending'),('vet_controlled_item','=',True)]"/><filter name="controlled" string="Controlled Items" domain="[('vet_controlled_item','=',True)]"/><filter name="draft" string="Requests for Quotation" domain="[('state','in',('draft','sent','to approve'))]"/><filter name="purchased" string="Purchase Orders" domain="[('state','in',('purchase','done'))]"/><separator/><filter name="group_vendor" string="Vendor" context="{'group_by':'partner_id'}"/><filter name="group_clinic" string="Clinic" context="{'group_by':'vet_clinic_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
<record id="action_vet_purchase_order" model="ir.actions.act_window"><field name="name">Veterinary Purchase Orders</field><field name="res_model">purchase.order</field><field name="view_mode">list,kanban,form</field><field name="domain">[('is_vet_purchase','=',True)]</field><field name="search_view_id" ref="view_vet_purchase_order_search"/><field name="context">{'default_is_vet_purchase':True}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first veterinary purchase order</p><p>Replenish approved veterinary products and trace controlled-item review through receipt.</p></field></record>
</odoo>
