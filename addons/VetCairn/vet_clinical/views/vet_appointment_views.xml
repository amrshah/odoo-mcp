<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_appointment_form_clinical" model="ir.ui.view">
        <field name="name">vet.appointment.form.clinical</field>
        <field name="model">vet.appointment</field>
        <field name="inherit_id" ref="vet_appointment.view_vet_appointment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_encounter" type="object" class="oe_stat_button" icon="fa-stethoscope" groups="vet_base.group_vet_technician">
                    <field name="encounter_count" widget="statinfo" string="Clinical Note"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
