<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_reminder_list" model="ir.ui.view"><field name="name">vet.reminder.list</field><field name="model">vet.reminder</field><field name="arch" type="xml"><list decoration-danger="is_overdue or state == 'failed'" decoration-success="state == 'sent'" decoration-muted="state == 'cancelled'"><field name="is_overdue" column_invisible="True"/><field name="priority" widget="priority"/><field name="due_date"/><field name="patient_id"/><field name="client_id"/><field name="reminder_type_id"/><field name="subject"/><field name="channel" widget="badge"/><field name="client_email" optional="hide"/><field name="client_phone" optional="hide"/><field name="sent_at" optional="show"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_reminder_form" model="ir.ui.view"><field name="name">vet.reminder.form</field><field name="model">vet.reminder</field><field name="arch" type="xml"><form><header><button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/><button name="action_mark_sent" type="object" string="Mark Sent / Completed" class="btn-primary" invisible="state not in ('pending','failed')"/><button name="action_fail" type="object" string="Mark Failed" invisible="state != 'pending'"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','pending','failed')"/><field name="state" widget="statusbar" statusbar_visible="draft,pending,sent"/></header><sheet><widget name="web_ribbon" title="OVERDUE" bg_color="text-bg-danger" invisible="not is_overdue"/><div class="oe_title"><div class="d-flex gap-2"><field name="priority" widget="priority"/><h1><field name="subject"/></h1></div><h2 class="text-muted"><field name="patient_id" options="{'no_create':True}"/></h2><div><field name="name" readonly="1"/></div></div><group><group string="Recipient"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id" readonly="1"/><field name="client_email" widget="email" readonly="1"/><field name="client_phone" widget="phone" readonly="1"/></group><group string="Schedule"><field name="reminder_type_id" options="{'no_create':True}"/><field name="channel"/><field name="due_date"/><field name="appointment_id"/><field name="vaccination_id"/></group></group><notebook><page string="Message"><field name="message" placeholder="Reminder content..."/></page><page string="Delivery &amp; Audit"><group><field name="sent_at"/><field name="completed_by_id"/><field name="delivery_reference"/><field name="failure_reason" invisible="state != 'failed'"/></group></page><page string="Internal Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
<record id="view_vet_reminder_search" model="ir.ui.view"><field name="name">vet.reminder.search</field><field name="model">vet.reminder</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="client_id"/><field name="reminder_type_id"/><field name="subject"/><filter name="pending" string="Pending" domain="[('state','=','pending')]"/><filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><filter name="sent" string="Sent / Completed" domain="[('state','=','sent')]"/><separator/><filter name="group_channel" string="Channel" context="{'group_by':'channel'}"/><filter name="group_type" string="Type" context="{'group_by':'reminder_type_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_due" string="Due Date" context="{'group_by':'due_date'}"/></search></field></record>
<record id="action_vet_reminder" model="ir.actions.act_window"><field name="name">Reminders</field><field name="res_model">vet.reminder</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_vet_reminder_search"/><field name="context">{'search_default_pending':1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first patient reminder</p><p>Track due communications before connecting an approved email or SMS provider.</p></field></record>
</odoo>
