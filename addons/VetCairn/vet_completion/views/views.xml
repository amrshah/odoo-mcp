<?xml version="1.0"?><odoo>
<record id="users_clinic_security" model="ir.ui.view"><field name="name">res.users.vet.clinic.security</field><field name="model">res.users</field><field name="inherit_id" ref="vet_base.view_users_form_vetcairn"/><field name="arch" type="xml"><xpath expr="//field[@name='vet_clinic_ids']" position="before"><field name="vet_all_clinic_access"/></xpath></field></record>
<record id="ward_list" model="ir.ui.view"><field name="name">vet.ward.list</field><field name="model">vet.ward</field><field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="clinic_id"/><field name="active"/></list></field></record><record id="bed_list" model="ir.ui.view"><field name="name">vet.bed.list</field><field name="model">vet.bed</field><field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="ward_id"/><field name="clinic_id"/><field name="species_id"/><field name="status" widget="badge"/></list></field></record>
<record id="admission_list" model="ir.ui.view"><field name="name">vet.admission.list</field><field name="model">vet.admission</field><field name="arch" type="xml"><list decoration-success="state=='discharged'" decoration-warning="state=='ready'"><field name="name"/><field name="patient_id"/><field name="ward_id"/><field name="bed_id"/><field name="attending_id"/><field name="admitted_at"/><field name="expected_discharge"/><field name="state" widget="badge"/></list></field></record><record id="admission_form" model="ir.ui.view"><field name="name">vet.admission.form</field><field name="model">vet.admission</field><field name="arch" type="xml"><form><header><button name="action_admit" type="object" string="Admit" class="btn-primary" invisible="state!='draft'"/><button name="action_ready" type="object" string="Ready for Discharge" invisible="state!='admitted'"/><button name="action_discharge" type="object" string="Discharge" class="btn-primary" invisible="state not in ('admitted','ready')"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><group><field name="patient_id"/><field name="client_id"/><field name="encounter_id"/><field name="attending_id"/></group><group><field name="clinic_id"/><field name="ward_id"/><field name="bed_id"/><field name="admitted_at"/><field name="expected_discharge"/></group></group><notebook><page string="Admission"><field name="reason"/></page><page string="Handover"><field name="handover_notes"/></page><page string="Discharge"><field name="discharge_summary" widget="html"/></page></notebook></sheet><chatter/></form></field></record>
<record id="claim_list" model="ir.ui.view"><field name="name">vet.insurance.claim.list</field><field name="model">vet.insurance.claim</field><field name="arch" type="xml"><list><field name="name"/><field name="patient_id"/><field name="insurer_id"/><field name="invoice_id"/><field name="claimed_amount"/><field name="approved_amount"/><field name="paid_amount"/><field name="state" widget="badge"/></list></field></record><record id="claim_form" model="ir.ui.view"><field name="name">vet.insurance.claim.form</field><field name="model">vet.insurance.claim</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state!='draft'"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><field name="clinic_id"/><field name="patient_id"/><field name="client_id"/><field name="insurer_id"/><field name="policy_number"/><field name="invoice_id"/><field name="currency_id" invisible="1"/><field name="claimed_amount"/><field name="approved_amount"/><field name="paid_amount"/><field name="decision_reference"/><field name="decline_reason"/></group></sheet><chatter/></form></field></record>
<record id="adjustment_list" model="ir.ui.view"><field name="name">vet.financial.adjustment.list</field><field name="model">vet.financial.adjustment</field><field name="arch" type="xml"><list><field name="name"/><field name="adjustment_type"/><field name="partner_id"/><field name="patient_id"/><field name="invoice_id"/><field name="amount"/><field name="state" widget="badge"/></list></field></record><record id="adjustment_form" model="ir.ui.view"><field name="name">vet.financial.adjustment.form</field><field name="model">vet.financial.adjustment</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state!='draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="clinic_id"/><field name="adjustment_type"/><field name="partner_id"/><field name="patient_id"/><field name="invoice_id"/><field name="currency_id" invisible="1"/><field name="amount"/><field name="reason"/><field name="approved_by_id"/></group></sheet><chatter/></form></field></record>
<record id="migration_list" model="ir.ui.view"><field name="name">vet.migration.batch.list</field><field name="model">vet.migration.batch</field><field name="arch" type="xml"><list><field name="name"/><field name="source"/><field name="state" widget="badge"/><field name="validated_at"/><field name="rehearsal_at"/></list></field></record><record id="migration_form" model="ir.ui.view"><field name="name">vet.migration.batch.form</field><field name="model">vet.migration.batch</field><field name="arch" type="xml"><form><header><button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state!='draft'"/><button name="action_ready" type="object" string="Mark Ready" invisible="state!='validated'"/><button name="action_rehearse" type="object" string="Record Rehearsal" invisible="state!='ready'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="source"/><field name="company_id"/><field name="notes"/></group><field name="line_ids"><list editable="bottom"><field name="sequence"/><field name="record_type"/><field name="source_key"/><field name="payload"/><field name="duplicate_key"/><field name="status" widget="badge"/><field name="message"/></list></field></sheet><chatter/></form></field></record>
<record id="act_admission" model="ir.actions.act_window"><field name="name">Hospital Census</field><field name="res_model">vet.admission</field><field name="view_mode">list,form</field></record><record id="act_ward" model="ir.actions.act_window"><field name="name">Wards</field><field name="res_model">vet.ward</field><field name="view_mode">list</field></record><record id="act_bed" model="ir.actions.act_window"><field name="name">Beds / Cages</field><field name="res_model">vet.bed</field><field name="view_mode">list</field></record><record id="act_claim" model="ir.actions.act_window"><field name="name">Insurance Claims</field><field name="res_model">vet.insurance.claim</field><field name="view_mode">list,form</field></record><record id="act_adjustment" model="ir.actions.act_window"><field name="name">Financial Adjustments</field><field name="res_model">vet.financial.adjustment</field><field name="view_mode">list,form</field></record><record id="act_migration" model="ir.actions.act_window"><field name="name">Migration Rehearsals</field><field name="res_model">vet.migration.batch</field><field name="view_mode">list,form</field></record></odoo>
