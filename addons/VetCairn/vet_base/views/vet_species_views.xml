<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_species_list" model="ir.ui.view">
        <field name="name">vet.species.list</field>
        <field name="model">vet.species</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_vet_species_form" model="ir.ui.view">
        <field name="name">vet.species.form</field>
        <field name="model">vet.species</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="breed_ids" context="{'default_species_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="active" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vet_species" model="ir.actions.act_window">
        <field name="name">Species</field>
        <field name="res_model">vet.species</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

