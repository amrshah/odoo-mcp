<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_patient_form_vaccination" model="ir.ui.view">
        <field name="name">vet.patient.form.vaccination</field>
        <field name="model">vet.patient</field>
        <field name="inherit_id" ref="vet_clinical.view_vet_patient_form_clinical"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vaccinations" type="object" class="oe_stat_button" icon="fa-medkit">
                    <field name="vaccination_count" widget="statinfo" string="Vaccinations"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
