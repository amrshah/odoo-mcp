<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_order_form_vetcairn" model="ir.ui.view"><field name="name">sale.order.form.vetcairn</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml">
<xpath expr="//header" position="inside"><button name="action_vet_accept" type="object" string="Record Client Acceptance" class="btn-primary" invisible="not is_vet_estimate or vet_approval_state != 'pending' or state not in ('draft','sent')" groups="vet_commercial.group_vet_estimate_user"/><button name="action_vet_decline" type="object" string="Record Decline" invisible="not is_vet_estimate or vet_approval_state != 'pending' or state not in ('draft','sent')" groups="vet_commercial.group_vet_estimate_user"/></xpath>
<xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="before"><field name="is_vet_estimate" invisible="1"/><field name="vet_patient_id" string="Patient" options="{'no_create':True}" invisible="not is_vet_estimate" required="is_vet_estimate" readonly="state in ('sale','cancel')"/><field name="vet_clinic_id" invisible="not is_vet_estimate" options="{'no_create':True}"/></xpath>
<xpath expr="//notebook" position="inside"><page string="Veterinary Estimate" name="vetcairn_estimate" invisible="not is_vet_estimate"><group><group string="Clinical Context"><field name="vet_appointment_id" options="{'no_create':True}"/><field name="vet_encounter_id" options="{'no_create':True}"/><field name="vet_treatment_plan_id" options="{'no_create':True}"/><field name="vet_clinical_notes"/></group><group string="Client Decision"><field name="vet_approval_state" widget="badge"/><field name="vet_approved_by_name"/><field name="vet_approved_at"/><field name="vet_decline_reason" invisible="vet_approval_state != 'declined'"/><field name="vet_deposit_percent"/><field name="vet_deposit_amount" widget="monetary"/></group></group></page></xpath>
</field></record>
<record id="view_vet_estimate_list" model="ir.ui.view"><field name="name">sale.order.vet.estimate.list</field><field name="model">sale.order</field><field name="arch" type="xml"><list decoration-success="vet_approval_state == 'accepted'" decoration-danger="vet_approval_state == 'declined'" decoration-warning="vet_approval_state == 'pending'"><field name="name"/><field name="date_order"/><field name="vet_patient_id"/><field name="partner_id"/><field name="vet_clinic_id"/><field name="amount_untaxed" widget="monetary"/><field name="amount_total" widget="monetary"/><field name="currency_id" column_invisible="True"/><field name="vet_deposit_amount" widget="monetary"/><field name="validity_date"/><field name="vet_approval_state" widget="badge"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_estimate_search" model="ir.ui.view"><field name="name">sale.order.vet.estimate.search</field><field name="model">sale.order</field><field name="arch" type="xml"><search><field name="name"/><field name="vet_patient_id"/><field name="partner_id"/><field name="vet_clinic_id"/><filter name="pending" string="Pending Client Decision" domain="[('vet_approval_state','=','pending')]"/><filter name="accepted" string="Accepted" domain="[('vet_approval_state','=','accepted')]"/><filter name="declined" string="Declined" domain="[('vet_approval_state','=','declined')]"/><filter name="quotation" string="Quotations" domain="[('state','in',('draft','sent'))]"/><separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_approval" string="Client Decision" context="{'group_by':'vet_approval_state'}"/><filter name="group_clinic" string="Clinic" context="{'group_by':'vet_clinic_id'}"/></search></field></record>
<record id="action_vet_estimate" model="ir.actions.act_window"><field name="name">Veterinary Estimates</field><field name="res_model">sale.order</field><field name="view_mode">list,kanban,form</field><field name="domain">[('is_vet_estimate','=',True)]</field><field name="search_view_id" ref="view_vet_estimate_search"/><field name="context">{'default_is_vet_estimate':True}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first veterinary estimate</p><p>Present treatment options, discounts, taxes, deposit expectations, and obtain client approval before confirmation.</p></field></record>
</odoo>
