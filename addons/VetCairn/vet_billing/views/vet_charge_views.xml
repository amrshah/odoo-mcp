<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_charge_list" model="ir.ui.view"><field name="name">vet.charge.list</field><field name="model">vet.charge</field><field name="arch" type="xml"><list decoration-warning="state == 'ready'" decoration-success="state == 'invoiced'" decoration-muted="state == 'cancelled'"><field name="charge_datetime"/><field name="name" optional="hide"/><field name="patient_id"/><field name="client_id"/><field name="product_id"/><field name="description"/><field name="quantity"/><field name="unit_price" widget="monetary"/><field name="subtotal" widget="monetary"/><field name="currency_id" column_invisible="True"/><field name="invoice_id" optional="show"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_charge_form" model="ir.ui.view"><field name="name">vet.charge.form</field><field name="model">vet.charge</field><field name="arch" type="xml"><form><header><button name="action_ready" type="object" string="Ready to Invoice" class="btn-primary" invisible="state != 'draft'"/><button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'ready'" groups="vet_billing.group_vet_billing_user"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','ready')"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,invoiced"/></header><sheet><div class="oe_title"><h1><field name="patient_id" options="{'no_create':True}"/></h1><h2 class="text-muted"><field name="description"/></h2><div><field name="name" readonly="1"/></div></div><group><group string="Patient &amp; Visit"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id" readonly="1"/><field name="appointment_id"/><field name="encounter_id"/><field name="charge_datetime"/></group><group string="Charge"><field name="product_id" options="{'no_create':True}"/><field name="quantity"/><field name="unit_price" widget="monetary"/><field name="tax_ids" widget="many2many_tags"/><field name="subtotal" widget="monetary" readonly="1"/><field name="currency_id" invisible="1"/><field name="invoice_id" readonly="1"/></group></group><field name="notes" placeholder="Internal billing note..."/></sheet><chatter/></form></field></record>
<record id="view_vet_charge_search" model="ir.ui.view"><field name="name">vet.charge.search</field><field name="model">vet.charge</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="client_id"/><field name="product_id"/><field name="invoice_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="ready" string="Ready to Invoice" domain="[('state','=','ready')]"/><filter name="invoiced" string="Invoiced" domain="[('state','=','invoiced')]"/><separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/><filter name="group_client" string="Client" context="{'group_by':'client_id'}"/></search></field></record>
<record id="action_vet_charge" model="ir.actions.act_window"><field name="name">Veterinary Charges</field><field name="res_model">vet.charge</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_vet_charge_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Capture the first veterinary charge</p><p>Link services and products to a patient visit, then create a native Odoo invoice.</p></field></record>
</odoo>
