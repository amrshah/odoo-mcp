<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_prescription_list" model="ir.ui.view"><field name="name">vet.prescription.list</field><field name="model">vet.prescription</field><field name="arch" type="xml"><list decoration-warning="state == 'pending'" decoration-success="state == 'dispensed'" decoration-danger="state == 'denied'" decoration-muted="state == 'cancelled'"><field name="prescribed_at"/><field name="name" optional="hide"/><field name="patient_id"/><field name="medication_id"/><field name="controlled"/><field name="dose"/><field name="frequency"/><field name="quantity"/><field name="quantity_unit"/><field name="prescriber_id"/><field name="state" widget="badge"/></list></field></record>
<record id="view_vet_prescription_form" model="ir.ui.view"><field name="name">vet.prescription.form</field><field name="model">vet.prescription</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'" groups="vet_prescription.group_vet_controlled_medication"/><button name="action_deny" type="object" string="Deny" invisible="state != 'pending'" groups="vet_prescription.group_vet_controlled_medication"/><button name="action_dispense" type="object" string="Record Dispensing" class="btn-primary" invisible="state != 'approved'" groups="vet_base.group_vet_technician"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','pending','approved')"/><field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,dispensed"/></header><sheet><widget name="web_ribbon" title="CONTROLLED" bg_color="text-bg-warning" invisible="not controlled"/><div class="oe_title"><h1><field name="patient_id" options="{'no_create':True}"/></h1><h2 class="text-muted"><field name="medication_id" options="{'no_create':True}"/></h2><div><field name="name" readonly="1"/></div></div><group><group string="Clinical"><field name="company_id" groups="base.group_multi_company"/><field name="clinic_id"/><field name="client_id" readonly="1"/><field name="encounter_id"/><field name="prescriber_id"/><field name="prescribed_at"/><field name="clinical_indication"/></group><group string="Directions"><field name="dose"/><field name="route"/><field name="frequency"/><field name="duration"/><label for="quantity"/><div class="o_row"><field name="quantity"/><field name="quantity_unit"/></div><field name="refills_authorized"/><field name="refills_remaining"/></group></group><notebook><page string="Instructions"><field name="instructions" placeholder="Clear medication directions for the client..."/></page><page string="Dispensing"><group><field name="approved_by_id"/><field name="approved_at"/><field name="dispensed_by_id"/><field name="dispensed_at"/><field name="lot_number"/><field name="expiry_date"/></group></page><page string="Denial" invisible="state != 'denied'"><field name="denial_reason"/></page></notebook></sheet><chatter/></form></field></record>
<record id="view_vet_prescription_search" model="ir.ui.view"><field name="name">vet.prescription.search</field><field name="model">vet.prescription</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="medication_id"/><field name="prescriber_id"/><filter name="pending" string="Pending Approval" domain="[('state','=','pending')]"/><filter name="approved" string="Ready to Dispense" domain="[('state','=','approved')]"/><filter name="controlled" string="Controlled" domain="[('controlled','=',True)]"/><filter name="dispensed" string="Dispensed" domain="[('state','=','dispensed')]"/><separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/><filter name="group_medication" string="Medication" context="{'group_by':'medication_id'}"/></search></field></record>
<record id="action_vet_prescription" model="ir.actions.act_window"><field name="name">Prescriptions</field><field name="res_model">vet.prescription</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_vet_prescription_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first prescription</p><p>Prescribe, approve, and record dispensing with a complete audit trail.</p></field></record>
</odoo>
