<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_vet_product_template_list" model="ir.ui.view"><field name="name">product.template.veterinary.list</field><field name="model">product.template</field><field name="arch" type="xml"><list decoration-danger="vet_controlled" decoration-warning="qty_available &lt; vet_reorder_min" multi_edit="1"><field name="currency_id" column_invisible="True"/><field name="name"/><field name="default_code"/><field name="vet_item_type" widget="badge"/><field name="vet_controlled"/><field name="categ_id" optional="show"/><field name="vet_storage_location" optional="show"/><field name="tracking"/><field name="qty_available"/><field name="virtual_available" optional="show"/><field name="vet_reorder_min"/><field name="list_price" widget="monetary"/><field name="active" column_invisible="True"/></list></field></record>
<record id="view_product_template_form_vetcairn" model="ir.ui.view"><field name="name">product.template.form.vetcairn</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/><field name="arch" type="xml"><xpath expr="//page[@name='general_information']" position="after"><page name="vetcairn" string="VetCairn"><group><group string="Veterinary Classification"><field name="is_vet_item"/><field name="vet_item_type" required="is_vet_item"/><field name="vet_controlled"/><field name="vet_storage_location"/><field name="vet_print_label"/><field name="vet_print_on_invoice"/></group><group string="Stock &amp; Traceability"><field name="is_storable"/><field name="tracking"/><field name="use_expiration_date"/><field name="expiration_time" invisible="not use_expiration_date"/><field name="vet_reorder_min"/><field name="vet_reorder_max"/></group></group><group><group string="Concentration &amp; Dose"><label for="vet_concentration"/><div class="o_row"><field name="vet_concentration"/><field name="vet_concentration_unit"/></div><field name="vet_default_route"/><field name="vet_dose_min"/><field name="vet_dose_max"/><field name="vet_dose_unit"/></group><group string="Current Availability"><field name="qty_available" readonly="1"/><field name="virtual_available" readonly="1"/><field name="incoming_qty" readonly="1"/><field name="outgoing_qty" readonly="1"/></group></group><field name="vet_clinical_instructions" placeholder="Storage, handling, dispensing, warning, and dose guidance..."/></page></xpath></field></record>
<record id="view_vet_product_template_search" model="ir.ui.view"><field name="name">product.template.veterinary.search</field><field name="model">product.template</field><field name="arch" type="xml"><search><field name="name"/><field name="default_code"/><field name="categ_id"/><field name="vet_item_type"/><filter name="controlled" string="Controlled" domain="[('vet_controlled','=',True)]"/><filter name="medications" string="Medications" domain="[('vet_item_type','=','medication')]"/><filter name="vaccines" string="Vaccines" domain="[('vet_item_type','=','vaccine')]"/><separator/><filter name="group_type" string="Item Type" context="{'group_by':'vet_item_type'}"/><filter name="group_category" string="Category" context="{'group_by':'categ_id'}"/></search></field></record>
<record id="action_vet_inventory_items" model="ir.actions.act_window"><field name="name">Veterinary Inventory</field><field name="res_model">product.template</field><field name="view_mode">list,form</field><field name="domain">[('is_vet_item','=',True)]</field><field name="search_view_id" ref="view_vet_product_template_search"/><field name="context">{'default_is_vet_item': True, 'default_is_storable': True}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first veterinary inventory item</p><p>Track medication, vaccine, supply, food, and retail stock using Odoo lots and expiry dates.</p></field></record>
</odoo>
